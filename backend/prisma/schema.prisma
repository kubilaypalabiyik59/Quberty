// =====================
// SUPPLIERS & PURCHASE
// =====================

model Supplier {
  id            String   @id @default(uuid()) @db.Uuid
  tenant_id     String   @db.Uuid
  code          String
  name          String
  contact_name  String?
  email         String?
  phone         String?
  address       String?
  city          String?
  country       String?
  payment_terms Int?     @default(30)
  currency      String   @default("BOB")
  /// Party side of the tax intersection. Nullable — falls back to the default on
  /// PurchaseParameters/SalesParameters when unset, which is how existing rows keep
  /// working unchanged.
  tax_group_id  String?  @db.Uuid
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  purchase_orders  PurchaseOrder[]
  tax_group        TaxGroup?                 @relation(fields: [tax_group_id], references: [id])
  rfq_requests     RfqRequest[]
  preferred_on_req PurchaseRequisitionLine[] @relation("preferred_supplier")
  product_receipts ProductReceipt[]
  vendor_invoices  VendorInvoice[]
  trade_agreements TradeAgreement[]

  @@unique([tenant_id, code])
  @@map("suppliers")
}

model PurchaseOrder {
  id                  String    @id @default(uuid()) @db.Uuid
  tenant_id           String    @db.Uuid
  po_number           String    @unique
  supplier_id         String    @db.Uuid
  warehouse_id        String    @db.Uuid
  status              String    @default("DRAFT")
  order_date          DateTime  @default(now()) @db.Date
  expected_date       DateTime? @db.Date
  currency            String    @default("TRY")
  subtotal            Decimal   @default(0) @db.Decimal(14, 2)
  tax_amount          Decimal   @default(0) @db.Decimal(14, 2)
  total_amount        Decimal   @default(0) @db.Decimal(14, 2)
  notes               String?
  created_by          String?   @db.Uuid
  confirmed_at        DateTime?
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt
  receive_location_id String?   @db.Uuid
  received_at         DateTime?
  received_by         String?   @db.Uuid
  packing_slip_url    String?
  paid_at             DateTime?
  paid_by             String?   @db.Uuid

  /// ── Document provenance (Source to Pay upstream) ────────────────────────
  /// Where this order came from. `DIRECT` means somebody raised the PO itself,
  /// which is how every historical row and every counter purchase behaves.
  ///
  /// This is deliberately a polymorphic (type, id) pair rather than a set of
  /// nullable FKs, because the set of upstream documents is genuinely open:
  /// REQUISITION and RFQ exist today, PURCHASE_AGREEMENT and PLANNED_ORDER are
  /// documented deferrals (SCOPE_AND_HOOKS.md §2). A new origin is a new enum
  /// value, not a migration.
  ///
  /// DIRECT | REQUISITION | RFQ | PURCHASE_AGREEMENT | PLANNED_ORDER
  source_document_type String  @default("DIRECT")
  source_document_id   String? @db.Uuid

  /// Derived from `warehouse_id`, never entered — site is the warehouse's site.
  /// Denormalised so the operations panel can group by geography without
  /// joining through warehouses on every query; kept in step by
  /// `inventoryDimension.service.ts`. `warehouse_id` here is already NOT NULL,
  /// so unlike the sales side this backfilled to 100%.
  site_id String? @db.Uuid

  supplier         Supplier            @relation(fields: [supplier_id], references: [id])
  warehouse        Warehouse           @relation(fields: [warehouse_id], references: [id])
  site             Site?               @relation(fields: [site_id], references: [id])
  lines            PurchaseOrderLine[]
  arrival_journals ArrivalJournal[]
  product_receipts ProductReceipt[]
  vendor_invoices  VendorInvoice[]

  @@index([tenant_id, source_document_type, source_document_id])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id           String  @id @default(uuid()) @db.Uuid
  po_id        String  @db.Uuid
  product_id   String  @db.Uuid
  variant_id   String? @db.Uuid
  quantity     Decimal @db.Decimal(12, 2)
  received_qty Decimal @default(0) @db.Decimal(12, 2)
  unit_cost    Decimal @db.Decimal(12, 4)
  line_total   Decimal @db.Decimal(14, 2)
  sort_order   Int     @default(0)

  /// Line-level tax — the hook for multi-rate jurisdictions.
  /// Bolivia has one rate, so tax is computed on the document total today and
  /// these stay null. Turkey (KDV 20/10/1) and Germany (USt 19/7) cannot be
  /// represented that way: an order holding one standard-rated and one
  /// reduced-rate product has no single header rate. These columns exist now so
  /// that refactor is a service change, not a migration against live orders.
  item_tax_group_id String?  @db.Uuid
  tax_amount        Decimal? @db.Decimal(14, 2)
  tax_base          Decimal? @db.Decimal(14, 2)

  /// Line-level provenance. The HEADER link is not sufficient on the purchase
  /// side: **[OFFICIAL]** an RFQ award may accept lines from several vendors
  /// ("You can also accept lines from different vendors" —
  /// learn.microsoft.com/dynamics365/supply-chain/procurement/request-quotations),
  /// and a purchase order carries exactly one supplier. One RFQ case therefore
  /// fans out into several POs, and only the line records which bid line it was
  /// awarded from. Without this column the award audit trail is unreconstructable.
  ///
  /// Points at `rfq_request_lines.id` or `purchase_requisition_lines.id`, per the
  /// header's `source_document_type`. Not an FK for the same reason the header
  /// pair is not.
  source_line_id    String? @db.Uuid
  /// Hook only — purchase agreements are deferred (SCOPE_AND_HOOKS.md §2), and
  /// the documented requirement is that consumption against a commitment must be
  /// traceable at line level or agreement fulfilment cannot be computed from
  /// history. Nothing reads it yet.
  agreement_line_id String? @db.Uuid

  /// How much of this line a posted vendor invoice has already claimed.
  /// **[OFFICIAL]** the purchase order becomes *Invoiced* only when both the
  /// invoice remainder and the deliver remainder reach zero, so the two
  /// accumulators must be tracked separately — `received_qty` above cannot stand
  /// in for this one.
  invoiced_qty Decimal @default(0) @db.Decimal(12, 2)

  /// Per-line override of the matching policy. **[OFFICIAL]** the legal-entity
  /// policy "can be overridden for a specific vendor, item, or vendor and item
  /// combination", and for a specific purchase order line, when the parameters
  /// page permits it. NULL means "inherit from the resolved policy".
  /// NONE | TWO_WAY | THREE_WAY
  matching_policy String?

  purchase_order PurchaseOrder        @relation(fields: [po_id], references: [id], onDelete: Cascade)
  product        Product              @relation(fields: [product_id], references: [id])
  /// Migration 014 — real FK, same as the sales side.
  variant        ProductVariant?      @relation(fields: [variant_id], references: [id])
  receipt_lines  ProductReceiptLine[]
  invoice_lines  VendorInvoiceLine[]

  @@map("purchase_order_lines")
}

// =============================================================================
// PRODUCT RECEIPT — the physical half of a purchase
//
// **[OFFICIAL]** "A vendor invoice completes the cycle from purchase order to
// product receipt to vendor invoice."
// learn.microsoft.com/dynamics365/finance/accounts-payable/vendor-invoices-overview
//
// Before this existed, "received" was a status and a timestamp on the order
// header. That made three things impossible: several deliveries against one
// order, knowing WHICH delivery brought what, and three-way matching — which is
// not a comparison of two numbers but a question about specific receipt lines.
// =============================================================================

model ProductReceipt {
  id              String  @id @default(uuid()) @db.Uuid
  tenant_id       String  @db.Uuid
  legal_entity_id String? @db.Uuid

  /// Our own document number, from the PRODUCT_RECEIPT sequence.
  receipt_number String

  /// **[OFFICIAL]** "During product receipt, specify a product receipt identifier,
  /// which is typically a reference to the packing slip from the supplier. This
  /// identifier is required for accounting, because it enables checks or audits of
  /// supplier packing slips against what is received."
  /// Required, for exactly that reason — it is the audit anchor, not a note.
  packing_slip String

  purchase_order_id String  @db.Uuid
  supplier_id       String  @db.Uuid
  warehouse_id      String  @db.Uuid
  location_id       String? @db.Uuid

  /// DRAFT | POSTED | CANCELLED
  status       String   @default("DRAFT")
  receipt_date DateTime @default(now()) @db.Date

  /// The voucher this receipt raised, when receipt posting is enabled.
  /// Null when `PurchaseParameters.post_product_receipt_in_ledger` is false, or
  /// when every line belongs to an item model group with post_physical_inventory
  /// off — both are legitimate configurations, not failures.
  journal_entry_id String? @db.Uuid

  /// **[OFFICIAL]** "When correcting a product receipt, you can only reduce the
  /// received quantity. To raise the quantity, you must post a new product receipt
  /// journal." A correction is therefore a new document pointing at the original,
  /// never an edit of it — which is also what keeps the ledger reproducible.
  corrects_receipt_id String? @db.Uuid

  notes      String?
  created_by String?   @db.Uuid
  posted_at  DateTime?
  posted_by  String?   @db.Uuid
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  purchase_order PurchaseOrder        @relation(fields: [purchase_order_id], references: [id])
  supplier       Supplier             @relation(fields: [supplier_id], references: [id])
  warehouse      Warehouse            @relation(fields: [warehouse_id], references: [id])
  corrects       ProductReceipt?      @relation("ReceiptCorrection", fields: [corrects_receipt_id], references: [id])
  corrected_by   ProductReceipt[]     @relation("ReceiptCorrection")
  lines          ProductReceiptLine[]

  @@unique([tenant_id, receipt_number])
  @@index([tenant_id, purchase_order_id])
  @@index([tenant_id, supplier_id, status])
  @@map("product_receipts")
}

model ProductReceiptLine {
  id         String  @id @default(uuid()) @db.Uuid
  receipt_id String  @db.Uuid
  po_line_id String? @db.Uuid
  product_id String  @db.Uuid
  variant_id String? @db.Uuid

  quantity Decimal @db.Decimal(12, 2)

  /// The agreed price as it appears on the order — gross, i.e. what the supplier
  /// will invoice. Kept so price matching has something to compare against.
  unit_cost Decimal @db.Decimal(12, 4)

  /// What actually capitalises: the agreed price less recoverable tax. Stored per
  /// line, at receipt time, because the split depends on the tax codes in force on
  /// that date and must not be recomputed from today's configuration.
  ///
  /// This column is also the fix for a real divergence: inventory batches used to
  /// be written at the GROSS unit cost while the receipt voucher capitalised the
  /// NET, so the inventory subledger and the general ledger disagreed by the VAT
  /// on every single receipt.
  net_unit_cost   Decimal @db.Decimal(12, 4)
  line_net_amount Decimal @db.Decimal(14, 2)

  /// How much of this receipt line vendor invoices have consumed. Maintained from
  /// VendorInvoiceMatch, so an over-matched receipt is detectable.
  matched_qty Decimal @default(0) @db.Decimal(12, 2)

  location_id String? @db.Uuid
  sort_order  Int     @default(0)

  receipt ProductReceipt       @relation(fields: [receipt_id], references: [id], onDelete: Cascade)
  po_line PurchaseOrderLine?   @relation(fields: [po_line_id], references: [id])
  product Product              @relation(fields: [product_id], references: [id])
  matches VendorInvoiceMatch[]

  @@index([receipt_id])
  @@index([po_line_id])
  @@map("product_receipt_lines")
}

// =============================================================================
// VENDOR INVOICE — the financial half
//
// The supplier's document, not ours. It carries THEIR number, THEIR date, and in
// Bolivia their NIT and factura authorisation, because those are what the IVA
// purchase ledger is built from.
//
// **[OFFICIAL]** an invoice is not a projection of the order: "You can add a line
// that wasn't on the purchase order… The line is included only in matching
// policies for invoice totals." And an invoice need not reference an order at all
// — a utility bill is a vendor invoice with no purchase order.
// =============================================================================

model VendorInvoice {
  id              String  @id @default(uuid()) @db.Uuid
  tenant_id       String  @db.Uuid
  legal_entity_id String? @db.Uuid

  /// The supplier's invoice/factura number. Unique per supplier per tenant, never
  /// globally — two suppliers both numbering "0001" is normal. **[OFFICIAL]**
  /// duplicate handling is itself a parameter ("Check the invoice number used →
  /// Reject duplicate"), so this constraint is deliberately per-supplier.
  invoice_number  String
  /// Our internal handle, from the VENDOR_INVOICE sequence, so the document can be
  /// referenced in the ledger without depending on the supplier's numbering.
  internal_number String

  supplier_id       String  @db.Uuid
  purchase_order_id String? @db.Uuid

  invoice_date DateTime  @db.Date
  posting_date DateTime  @db.Date
  due_date     DateTime? @db.Date

  /// DRAFT | POSTED | CANCELLED
  status String @default("DRAFT")

  /// ── Fiscal document identity ─────────────────────────────────────────────
  /// Bolivia: NIT del proveedor, código de autorización, código de control — the
  /// three fields the IVA purchase ledger (Libro de Compras) is built from. Kept
  /// nullable and generically named because Turkey (e-Fatura ETTN) and Germany
  /// (Rechnungsnummer + USt-IdNr) fill the same slots with different content.
  supplier_tax_id           String?
  fiscal_authorization_code String?
  fiscal_control_code       String?

  currency String @default("BOB")

  /// Money, split exactly as the purchase side already splits it: what
  /// capitalises, what is reclaimable, what the supplier is owed.
  subtotal            Decimal @default(0) @db.Decimal(14, 2)
  tax_amount          Decimal @default(0) @db.Decimal(14, 2)
  non_recoverable_tax Decimal @default(0) @db.Decimal(14, 2)
  total_amount        Decimal @default(0) @db.Decimal(14, 2)

  /// ── Matching state ───────────────────────────────────────────────────────
  /// **[OFFICIAL]** the match status is a STORED, refreshable value in D365
  /// ("Last match" status, "Automatically update invoice header match status"),
  /// not something recomputed on read. History cannot be re-derived reliably once
  /// tolerances or policies change, so the verdict is persisted with the document.
  ///
  /// PENDING | PASSED | FAILED | NOT_APPLICABLE
  header_match_status String    @default("PENDING")
  totals_match_status String    @default("NOT_APPLICABLE")
  last_matched_at     DateTime?

  /// **[OFFICIAL]** with "Post invoice with discrepancies = Require approval", the
  /// "Approve posting with matching discrepancies" toggle must be set before the
  /// invoice can post with price or quantity errors.
  discrepancy_approved    Boolean   @default(false)
  discrepancy_approved_by String?   @db.Uuid
  discrepancy_approved_at DateTime?

  journal_entry_id String? @db.Uuid

  notes      String?
  created_by String?   @db.Uuid
  posted_at  DateTime?
  posted_by  String?   @db.Uuid
  paid_at    DateTime?
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  supplier       Supplier            @relation(fields: [supplier_id], references: [id])
  purchase_order PurchaseOrder?      @relation(fields: [purchase_order_id], references: [id])
  lines          VendorInvoiceLine[]

  @@unique([tenant_id, supplier_id, invoice_number])
  @@unique([tenant_id, internal_number])
  @@index([tenant_id, status, invoice_date])
  @@index([tenant_id, purchase_order_id])
  @@map("vendor_invoices")
}

model VendorInvoiceLine {
  id         String  @id @default(uuid()) @db.Uuid
  invoice_id String  @db.Uuid
  po_line_id String? @db.Uuid
  product_id String? @db.Uuid
  variant_id String? @db.Uuid

  /// Free text for a line with no product — a service, a utility bill, or the
  /// "line that wasn't on the purchase order" the documentation allows.
  description String?

  quantity   Decimal @db.Decimal(12, 2)
  unit_price Decimal @db.Decimal(12, 4)

  /// **[OFFICIAL]** net amount = (unit price x line quantity) + line charges
  /// - line discounts; net unit price = net amount / quantity. Both matching
  /// flavours are computed from these two, so they are stored, not derived.
  charges_amount  Decimal @default(0) @db.Decimal(14, 2)
  discount_amount Decimal @default(0) @db.Decimal(14, 2)
  line_net_amount Decimal @db.Decimal(14, 2)

  /// Per-line tax, same hook the order and quotation lines carry.
  item_tax_group_id String?  @db.Uuid
  tax_amount        Decimal? @db.Decimal(14, 2)
  tax_base          Decimal? @db.Decimal(14, 2)

  /// The policy and tolerance that were actually applied, resolved at entry and
  /// frozen. Re-resolving them later against changed configuration would silently
  /// rewrite the verdict on a posted document.
  matching_policy     String  @default("NONE")
  price_tolerance_pct Decimal @default(0) @db.Decimal(6, 4)

  /// Accumulated from VendorInvoiceMatch. **[OFFICIAL]** three-way matching
  /// compares this to `quantity`; an invoice line matched to no receipt at all
  /// fails, which is the failure the official example is built around.
  matched_receipt_qty Decimal @default(0) @db.Decimal(12, 2)

  /// PENDING | PASSED | FAILED | NOT_APPLICABLE — one verdict per official
  /// matching flavour, because they fail independently and for different reasons.
  price_match_status       String @default("NOT_APPLICABLE")
  price_total_match_status String @default("NOT_APPLICABLE")
  receipt_qty_match_status String @default("NOT_APPLICABLE")

  /// Signed, so an under-charge is distinguishable from an over-charge.
  price_variance_pct Decimal? @db.Decimal(9, 4)

  sort_order Int @default(0)

  invoice VendorInvoice        @relation(fields: [invoice_id], references: [id], onDelete: Cascade)
  po_line PurchaseOrderLine?   @relation(fields: [po_line_id], references: [id])
  product Product?             @relation(fields: [product_id], references: [id])
  matches VendorInvoiceMatch[]

  @@index([invoice_id])
  @@index([po_line_id])
  @@map("vendor_invoice_lines")
}

/// The join three-way matching actually requires.
///
/// **[OFFICIAL]** "if there are multiple product receipts for a single invoice
/// line, you need to run the process multiple times to achieve the full quantity
/// match", and an invoice may be built from "specific product receipt line items
/// from multiple purchase orders". One invoice line therefore consumes several
/// receipt lines, partially. A computed comparison cannot express that, and cannot
/// be re-audited after posting; a match row can.
model VendorInvoiceMatch {
  id              String @id @default(uuid()) @db.Uuid
  tenant_id       String @db.Uuid
  invoice_line_id String @db.Uuid
  receipt_line_id String @db.Uuid

  /// The quantity of the receipt line consumed by this invoice line. May be less
  /// than either side — partial matching is the documented normal case.
  quantity Decimal @db.Decimal(12, 2)

  created_at DateTime @default(now())
  created_by String?  @db.Uuid

  invoice_line VendorInvoiceLine  @relation(fields: [invoice_line_id], references: [id], onDelete: Cascade)
  receipt_line ProductReceiptLine @relation(fields: [receipt_line_id], references: [id])

  @@unique([tenant_id, invoice_line_id, receipt_line_id])
  @@index([tenant_id, receipt_line_id])
  @@map("vendor_invoice_matches")
}

/// Which matching policy applies to which purchase.
///
/// **[OFFICIAL]** the hierarchy is *Item and vendor → Item → Vendor → Legal
/// entity*. Note that the most specific level is an INTERSECTION of two axes, so
/// this table is deliberately two-axis — unlike `PostingProfile`, which is a
/// single axis with flat precedence and therefore cannot express "this item from
/// that vendor" at all. That asymmetry is a recorded decision, not an oversight:
/// see docs/process/VENDOR_INVOICE.md §5.
model MatchingPolicy {
  id              String  @id @default(uuid()) @db.Uuid
  tenant_id       String  @db.Uuid
  legal_entity_id String? @db.Uuid

  /// ALL | ITEM | ITEM_GROUP
  item_scope     String  @default("ALL")
  item_scope_id  String? @db.Uuid
  /// ALL | PARTY | PARTY_GROUP
  party_scope    String  @default("ALL")
  party_scope_id String? @db.Uuid

  /// NONE | TWO_WAY | THREE_WAY
  policy String

  description String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@unique([tenant_id, legal_entity_id, item_scope, item_scope_id, party_scope, party_scope_id])
  @@index([tenant_id, item_scope, party_scope])
  @@map("matching_policies")
}

/// Allowed price variance, resolved on the same two axes.
///
/// **[OFFICIAL]** the search order is spelled out as nine cells —
/// Table/Table, Table/Group, Table/All, Group/Table, Group/Group, Group/All,
/// All/Table, All/Group, All/All — and "the default legal entity price tolerance
/// is 0 percent… You can't delete the record for the default legal entity price
/// tolerance." The undeletable All/All row is enforced in the service, not by the
/// schema, so that a tenant can still be provisioned in one statement.
model PriceTolerance {
  id              String  @id @default(uuid()) @db.Uuid
  tenant_id       String  @db.Uuid
  legal_entity_id String? @db.Uuid

  item_scope     String  @default("ALL")
  item_scope_id  String? @db.Uuid
  party_scope    String  @default("ALL")
  party_scope_id String? @db.Uuid

  /// **[OFFICIAL]** "you can't enter a negative number as the price tolerance
  /// percentage… By default, negative price discrepancies are allowed." Whether a
  /// negative variance is flagged is a separate switch on the parameters page.
  tolerance_pct Decimal @default(0) @db.Decimal(6, 4)

  description String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@unique([tenant_id, legal_entity_id, item_scope, item_scope_id, party_scope, party_scope_id])
  @@index([tenant_id, item_scope, party_scope])
  @@map("price_tolerances")
}

// =====================
// CUSTOMERS & SALES
// =====================

model Customer {
  id             String    @id @default(uuid()) @db.Uuid
  tenant_id      String    @db.Uuid
  user_id        String?   @db.Uuid
  code           String
  first_name     String
  last_name      String
  email          String?
  phone          String?
  address        String?
  city           String?
  country        String?
  date_of_birth  DateTime? @db.Date
  segment        String    @default("regular")
  tags           String[]
  notes          String?
  lifetime_value Decimal   @default(0) @db.Decimal(14, 2)
  total_orders   Int       @default(0)
  /// Party side of the tax intersection — see the TAX ENGINE section. Nullable, so
  /// every existing customer keeps the SalesParameters default until classified.
  tax_group_id   String?   @db.Uuid
  /// NIT in Bolivia, VKN/TCKN in Turkey, USt-IdNr in Germany. A validated EU VAT ID
  /// is what makes an intra-community supply exempt, so this is a tax field, not a
  /// contact field.
  tax_id         String?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  sales_orders   SalesOrder[]
  tax_group      TaxGroup?        @relation(fields: [tax_group_id], references: [id])
  converted_from Lead[]           @relation("converted_customer")
  opportunities  Opportunity[]
  quotations     SalesQuotation[]
  trade_agreements TradeAgreement[]

  @@unique([tenant_id, code])
  @@map("customers")
}

model SalesOrder {
  id               String    @id @default(uuid()) @db.Uuid
  tenant_id        String    @db.Uuid
  order_number     String    @unique
  customer_id      String?   @db.Uuid
  source           String    @default("manual")
  status           String    @default("DRAFT")
  site_id          String?   @db.Uuid
  warehouse_id     String?   @db.Uuid
  currency         String    @default("BOB")
  subtotal         Decimal   @default(0) @db.Decimal(14, 2)
  discount_amount  Decimal   @default(0) @db.Decimal(14, 2)
  tax_amount       Decimal   @default(0) @db.Decimal(14, 2)
  total_amount     Decimal   @default(0) @db.Decimal(14, 2)
  shipping_address Json?
  notes            String?

  /// Date promised to the customer — the sales-side counterpart of
  /// `PurchaseOrder.expected_date`, mirroring D365's RequestedReceiptDate.
  ///
  /// Nullable on purpose. The operations panel measures health as
  /// elapsed / planned, and with no promise there is no denominator; such an
  /// order reports as `unknown` rather than being handed an invented window
  /// that would paint it green. See docs/design/CEO_DASHBOARD.md §5.1.
  requested_delivery_date DateTime? @db.Date

  wave_id          String?   @db.Uuid
  invoice_id       String?   @db.Uuid // soft ref to Factura — set when invoiced
  paid_at          DateTime?
  paid_by          String?   @db.Uuid
  returned_at      DateTime?
  created_by       String?   @db.Uuid
  confirmed_at     DateTime?
  shipped_at       DateTime?
  completed_at     DateTime?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  /// ── Document provenance (Prospect to Quote upstream) ────────────────────
  /// Mirrors `PurchaseOrder.source_document_type`. `DIRECT` is every historical
  /// row and every counter sale.
  ///
  /// Note this is NOT the same axis as the existing `source` column, which
  /// records the CHANNEL the order was captured through (manual / storefront /
  /// import / pos). An order can be `source = storefront` and
  /// `source_document_type = QUOTATION` at the same time. Channel and provenance
  /// are independent facts and collapsing them would lose one of them.
  ///
  /// DIRECT | QUOTATION | OPPORTUNITY | SALES_AGREEMENT | SUBSCRIPTION
  source_document_type String  @default("DIRECT")
  source_document_id   String? @db.Uuid

  customer        Customer?        @relation(fields: [customer_id], references: [id])
  site            Site?            @relation(fields: [site_id], references: [id])
  warehouse       Warehouse?       @relation(fields: [warehouse_id], references: [id])
  wave            Wave?            @relation(fields: [wave_id], references: [id])
  lines           SalesOrderLine[]
  shipments       Shipment[]
  created_by_user User?            @relation("created_by", fields: [created_by], references: [id])
  from_quotations SalesQuotation[] @relation("converted_order")

  @@index([tenant_id, status])
  @@index([tenant_id, created_at(sort: Desc)])
  @@index([tenant_id, source_document_type, source_document_id])
  @@map("sales_orders")
}

model SalesOrderLine {
  id           String  @id @default(uuid()) @db.Uuid
  order_id     String  @db.Uuid
  product_id   String  @db.Uuid
  variant_id   String? @db.Uuid
  quantity     Int
  unit_price   Decimal @db.Decimal(12, 4)
  discount_pct Decimal @default(0) @db.Decimal(5, 2)
  line_total   Decimal @db.Decimal(14, 2)
  sort_order   Int     @default(0)

  /// Line-level tax — the hook for multi-rate jurisdictions.
  /// Bolivia has one rate, so tax is computed on the document total today and
  /// these stay null. Turkey (KDV 20/10/1) and Germany (USt 19/7) cannot be
  /// represented that way: an order holding one standard-rated and one
  /// reduced-rate product has no single header rate. These columns exist now so
  /// that refactor is a service change, not a migration against live orders.
  item_tax_group_id String?  @db.Uuid
  tax_amount        Decimal? @db.Decimal(14, 2)
  tax_base          Decimal? @db.Decimal(14, 2)

  /// Line-level provenance — points at `sales_quotation_lines.id` when the order
  /// was confirmed from a quotation. Symmetrical with
  /// `PurchaseOrderLine.source_line_id`, and it is what makes partial conversion
  /// ("order three of the five quoted lines") reconstructable.
  source_line_id String? @db.Uuid

  /// How much of this line has been invoiced and delivered. The purchase side has
  /// carried these since migration 010 and it is what makes "received but not
  /// invoiced" answerable per line; the sales side had neither, so a partly
  /// invoiced order was not representable at all.
  invoiced_qty  Decimal @default(0) @db.Decimal(12, 2)
  delivered_qty Decimal @default(0) @db.Decimal(12, 2)

  order   SalesOrder      @relation(fields: [order_id], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [product_id], references: [id])
  factura_lines FacturaLine[]
  /// Migration 014 — was a bare UUID with no FK, which is how 37 units came to
  /// sit on a variant nothing referenced.
  variant ProductVariant? @relation(fields: [variant_id], references: [id])

  @@map("sales_order_lines")
}

model Shipment {
  id                String    @id @default(uuid()) @db.Uuid
  tenant_id         String    @db.Uuid
  shipment_number   String    @unique
  order_id          String    @db.Uuid
  status            String    @default("PENDING")
  carrier           String?
  tracking_number   String?
  shipped_at        DateTime?
  delivered_at      DateTime?
  from_warehouse_id String?   @db.Uuid
  created_at        DateTime  @default(now())

  order SalesOrder @relation(fields: [order_id], references: [id])

  @@map("shipments")
}

// =====================
// HR
// =====================

model Employee {
  id               String    @id @default(uuid()) @db.Uuid
  tenant_id        String    @db.Uuid
  user_id          String?   @db.Uuid
  employee_code    String
  /// @deprecated migration 018 — superseded by `department_id`. Kept, not dropped,
  /// on the same reasoning as `ProductVariant.size`: nothing is lost and the two
  /// representations stay comparable. Dropping it is a separate decision.
  department       String?
  /// The organisational department, as an operating unit.
  /// **[OFFICIAL]** D365 has no department table — a department is an operating
  /// unit of type *Department*. See `OperatingUnit`.
  department_id    String?   @db.Uuid
  /// Free text. D365 reaches the department THROUGH the position ("A position
  /// exists in a department"); we attach the employee directly and cut the
  /// job/position master — see the note on `OperatingUnit`.
  position         String?
  hire_date        DateTime? @db.Date
  salary           Decimal?  @db.Decimal(12, 2)
  assigned_site_id String?   @db.Uuid
  is_active        Boolean   @default(true)
  // POS device credentials
  pos_device_id    String? // human label e.g. "CAJA-01"
  pos_pin_hash     String? // bcrypt hash of cashier PIN
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  user          User?          @relation(fields: [user_id], references: [id])
  assigned_site Site?          @relation(fields: [assigned_site_id], references: [id])
  dept          OperatingUnit? @relation("employee_department", fields: [department_id], references: [id])
  manages       OperatingUnit[] @relation("operating_unit_manager")

  @@unique([tenant_id, employee_code])
  @@index([department_id], map: "employees_department_idx")
  @@map("employees")
}

/// The organisational master behind the department financial dimension.
///
/// **[OFFICIAL]** D365 does not have a `departments` table. A department is an
/// **operating unit** whose type is *Department*:
///
/// > "Department — An operating unit that represents a category or functional part
/// > of an organization that performs a specific task, such as sales or accounting.
/// > Used to report on functional areas. A department might have profit and loss
/// > responsibility, and might consist of a group of cost centers."
///
/// The five types are Cost center, Business unit, Value stream, Department and
/// Retail channel.
/// learn.microsoft.com/dynamics365/fin-ops-core/fin-ops/organization-administration/organizations-organizational-hierarchies#organizations
///
/// **[OFFICIAL]** and this is why the table sits here rather than in HR: operating
/// units "are commonly used as **financial dimensions**".
/// learn.microsoft.com/dynamics365/guidance/organizational-strategy/define-organizational-strategy
///
/// One table with a discriminator is therefore not generality for its own sake —
/// it is D365's own shape, and it turns FINANCIAL_DIMENSIONS.md §6.1's *guess* that
/// slots 3 and 4 would be "cost centre and channel" into two more rows of this
/// table rather than two more tables.
///
/// ── Deliberately CUT ───────────────────────────────────────────────────────
/// D365 models the tree as a separate *organization hierarchy* carrying an assigned
/// PURPOSE, draft/publish versioning and effective dates. That is five setup
/// screens before a shoe shop can tag a payroll line "Sales". The hook kept is
/// `parent_id` — a tree needs one nullable self-FK. Multiple hierarchies over the
/// same units are an additive edge table later.
///
/// Jobs and positions are cut too. **[OFFICIAL]** "A position exists in a
/// department", so D365 reaches the department through the position. If a position
/// master ever arrives, `Employee.department_id` becomes derived and the column
/// survives unchanged.
model OperatingUnit {
  id              String  @id @default(uuid()) @db.Uuid
  tenant_id       String  @db.Uuid
  legal_entity_id String? @db.Uuid

  /// D365's "Department number". **[OFFICIAL]** unique across ALL operating units
  /// regardless of type — "can't be the same as any other operating unit" — which
  /// is why the constraint is `(tenant_id, code)` and not per type.
  code        String
  name        String
  /// D365's "Search name" — the acronym staff actually type.
  search_name String?
  memo        String?

  unit_type String

  parent_id           String? @db.Uuid
  manager_employee_id String? @db.Uuid

  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  parent   OperatingUnit?  @relation("operating_unit_tree", fields: [parent_id], references: [id])
  children OperatingUnit[] @relation("operating_unit_tree")
  manager  Employee?       @relation("operating_unit_manager", fields: [manager_employee_id], references: [id])
  staff    Employee[]      @relation("employee_department")

  @@unique([tenant_id, code], map: "operating_units_tenant_code_key")
  @@index([tenant_id, unit_type], map: "operating_units_tenant_type_idx")
  @@index([parent_id], map: "operating_units_parent_idx")
  @@map("operating_units")
}

// =====================
// IMPORT
// =====================

model ImportJob {
  id             String    @id @default(uuid()) @db.Uuid
  tenant_id      String    @db.Uuid
  import_type    String
  file_name      String
  file_url       String
  status         String    @default("PENDING")
  column_mapping Json?
  total_rows     Int?
  valid_rows     Int?
  error_rows     Int?
  errors         Json?
  created_by     String?   @db.Uuid
  completed_at   DateTime?
  created_at     DateTime  @default(now())

  @@map("import_jobs")
}

