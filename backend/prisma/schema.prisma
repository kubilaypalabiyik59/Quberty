// Prisma Schema for Skarpine ERP
// Multi-tenant: tenant_id on every table

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =====================
// PLATFORM (public schema)
// =====================

model Tenant {
  id            String   @id @default(uuid()) @db.Uuid
  slug          String   @unique
  name          String
  plan          String   @default("starter")
  modules       Json
  branding      Json?
  language      String   @default("en")
  timezone      String   @default("UTC")
  currency_code String   @default("USD")
  tax_config    Json?
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@map("tenants")
}

// =====================
// USERS & AUTH
// =====================

model User {
  id            String    @id @default(uuid()) @db.Uuid
  tenant_id     String    @db.Uuid
  email         String
  password_hash String
  first_name    String
  last_name     String
  role          String    @default("employee")
  is_active     Boolean   @default(true)
  last_login_at DateTime?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  refresh_tokens RefreshToken[]
  sales_orders   SalesOrder[]   @relation("created_by")
  employees      Employee[]

  @@unique([tenant_id, email])
  @@map("users")
}

model RefreshToken {
  id         String   @id @default(uuid()) @db.Uuid
  user_id    String   @db.Uuid
  token_hash String
  expires_at DateTime
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

// =====================
// LOCATION HIERARCHY
// =====================

model Site {
  id         String   @id @default(uuid()) @db.Uuid
  tenant_id  String   @db.Uuid
  code       String
  name       String
  city       String
  country    String   @default("TR")
  address    String?
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())

  warehouses   Warehouse[]
  employees    Employee[]
  sales_orders SalesOrder[]
  quotations   SalesQuotation[]
  requisitions PurchaseRequisition[]

  @@unique([tenant_id, code])
  @@map("sites")
}

model Warehouse {
  id         String   @id @default(uuid()) @db.Uuid
  tenant_id  String   @db.Uuid
  site_id    String   @db.Uuid
  code       String
  name       String
  type       String   @default("standard")
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())

  site                Site                @relation(fields: [site_id], references: [id])
  zones               WarehouseZone[]
  purchase_orders     PurchaseOrder[]
  sales_orders        SalesOrder[]
  warehouse_work      WarehouseWork[]
  waves               Wave[]
  arrival_journals    ArrivalJournal[]
  location_directives LocationDirective[]
  work_templates      WorkTemplate[]
  wave_templates      WaveTemplate[]
  quotations          SalesQuotation[]
  requisitions        PurchaseRequisition[]
  rfq_cases           RfqCase[]

  @@unique([tenant_id, code])
  @@map("warehouses")
}

model WarehouseZone {
  id           String   @id @default(uuid()) @db.Uuid
  tenant_id    String   @db.Uuid
  warehouse_id String   @db.Uuid
  code         String
  name         String
  zone_type    String   @default("storage")
  created_at   DateTime @default(now())

  warehouse       Warehouse               @relation(fields: [warehouse_id], references: [id])
  locations       WarehouseLocation[]
  directive_lines LocationDirectiveLine[]

  @@unique([warehouse_id, code])
  @@map("warehouse_zones")
}

model WarehouseLocation {
  id                  String   @id @default(uuid()) @db.Uuid
  tenant_id           String   @db.Uuid
  zone_id             String   @db.Uuid
  code                String
  aisle               String?
  rack                String?
  shelf               String?
  bin                 String?
  location_type       String   @default("bulk")
  is_pick_location    Boolean  @default(false)
  is_receive_location Boolean  @default(false)
  max_weight          Decimal? @db.Decimal(10, 2)
  max_volume          Decimal? @db.Decimal(10, 2)
  is_active           Boolean  @default(true)
  created_at          DateTime @default(now())

  zone              WarehouseZone           @relation(fields: [zone_id], references: [id])
  inventory_stock   InventoryStock[]
  count_lines       InventoryCountLine[]
  pick_work_lines   WarehouseWorkLine[]     @relation("from_location")
  put_work_lines    WarehouseWorkLine[]     @relation("to_location")
  directive_lines   LocationDirectiveLine[]
  inv_tx_from       InventoryTransaction[]  @relation("inv_tx_from")
  inv_tx_to         InventoryTransaction[]  @relation("inv_tx_to")
  inventory_batches InventoryBatch[]

  @@unique([zone_id, code])
  @@map("warehouse_locations")
}

// =====================
// PRODUCTS
// =====================

model ProductCategory {
  id         String   @id @default(uuid()) @db.Uuid
  tenant_id  String   @db.Uuid
  parent_id  String?  @db.Uuid
  code       String
  name       String
  created_at DateTime @default(now())

  parent   ProductCategory?  @relation("subcategories", fields: [parent_id], references: [id])
  children ProductCategory[] @relation("subcategories")
  products Product[]

  @@unique([tenant_id, code])
  @@map("product_categories")
}

model Product {
  id                String   @id @default(uuid()) @db.Uuid
  tenant_id         String   @db.Uuid
  sku               String
  barcode           String?
  name              String
  description       String?
  category_id       String?  @db.Uuid
  brand             String?
  attributes        Json?
  uom_id            String?  @db.Uuid
  product_type      String   @default("physical") // physical, service, digital
  cost_price        Decimal? @db.Decimal(12, 2)
  selling_price     Decimal  @db.Decimal(12, 2)
  sale_price        Decimal? @db.Decimal(12, 2)
  weight_kg         Decimal? @db.Decimal(8, 3)
  reorder_point     Int      @default(0) // low-stock alert threshold; 0 = no alerting
  /// Product side of the tax intersection — see the TAX ENGINE section. Nullable,
  /// so every existing product keeps the SalesParameters default until classified.
  /// This is the column that carries reduced rates (Turkish KDV 10%/1%, German 7%).
  item_tax_group_id String?  @db.Uuid

  /// ── Released-product financial setup ────────────────────────────────────
  /// **[OFFICIAL]** both are mandatory fields on a D365 released product, and
  /// they answer different questions: the MODEL group is how the item is valued
  /// and controlled, the ITEM group is which GL accounts it posts to.
  /// Nullable here so existing products keep working; the resolver falls back to
  /// the ALL-scope posting profile and to InventoryParameters.costing_method
  /// exactly as before when they are unset.
  item_model_group_id String? @db.Uuid
  item_group_id       String? @db.Uuid

  images            String[]
  video_urls        String[]
  is_active         Boolean  @default(true)
  is_published      Boolean  @default(false)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  category               ProductCategory?       @relation(fields: [category_id], references: [id])
  uom                    UnitOfMeasure?         @relation(fields: [uom_id], references: [id])
  item_tax_group         ItemTaxGroup?          @relation(fields: [item_tax_group_id], references: [id])
  item_model_group       ItemModelGroup?        @relation(fields: [item_model_group_id], references: [id])
  item_group             ItemGroup?             @relation(fields: [item_group_id], references: [id])
  variants               ProductVariant[]
  inventory_stock        InventoryStock[]
  inventory_transactions InventoryTransaction[]
  inventory_batches      InventoryBatch[]
  sales_order_lines      SalesOrderLine[]
  purchase_order_lines   PurchaseOrderLine[]
  count_lines            InventoryCountLine[]
  work_lines             WarehouseWorkLine[]
  quotation_lines        SalesQuotationLine[]
  requisition_lines      PurchaseRequisitionLine[]
  rfq_case_lines         RfqCaseLine[]
  rfq_request_lines      RfqRequestLine[]

  @@unique([tenant_id, sku])
  @@map("products")
}

model ProductVariant {
  id              String   @id @default(uuid()) @db.Uuid
  tenant_id       String   @db.Uuid
  product_id      String   @db.Uuid
  sku_variant     String
  attributes      Json?
  size            String?
  color           String?
  barcode         String?
  additional_cost Decimal  @default(0) @db.Decimal(12, 2)
  is_active       Boolean  @default(true)
  created_at      DateTime @default(now())

  product                Product                @relation(fields: [product_id], references: [id], onDelete: Cascade)
  inventory_stock        InventoryStock[]
  count_lines            InventoryCountLine[]
  inventory_transactions InventoryTransaction[]
  inventory_batches      InventoryBatch[]

  /// The upstream document lines DO carry a real FK to the variant, unlike
  /// `SalesOrderLine.variant_id` / `PurchaseOrderLine.variant_id`, which are bare
  /// UUID columns. That gap is a known referential-integrity defect
  /// (SCOPE_AND_HOOKS.md §1 item 3) and repeating it on new tables would only
  /// make the eventual cleanup larger.
  quotation_lines   SalesQuotationLine[]
  requisition_lines PurchaseRequisitionLine[]
  rfq_case_lines    RfqCaseLine[]
  rfq_request_lines RfqRequestLine[]

  @@unique([tenant_id, sku_variant])
  @@map("product_variants")
}

// =====================
// INVENTORY
// =====================

model InventoryStock {
  id           String   @id @default(uuid()) @db.Uuid
  tenant_id    String   @db.Uuid
  product_id   String   @db.Uuid
  variant_id   String?  @db.Uuid
  location_id  String   @db.Uuid
  quantity     Int      @default(0)
  reserved_qty Int      @default(0)
  updated_at   DateTime @updatedAt

  product  Product           @relation(fields: [product_id], references: [id])
  location WarehouseLocation @relation(fields: [location_id], references: [id])
  variant  ProductVariant?   @relation(fields: [variant_id], references: [id])

  @@unique([tenant_id, product_id, variant_id, location_id], name: "tenant_id_product_id_variant_id_location_id")
  @@map("inventory_stock")
}

model InventoryTransaction {
  id               String   @id @default(uuid()) @db.Uuid
  tenant_id        String   @db.Uuid
  transaction_type String
  reference_type   String?
  reference_id     String?  @db.Uuid
  reference_number String? // human-readable: PO-2026-00004 / SO-2026-00004
  product_id       String   @db.Uuid
  variant_id       String?  @db.Uuid
  from_location_id String?  @db.Uuid
  to_location_id   String?  @db.Uuid
  quantity         Int
  unit_cost        Decimal? @db.Decimal(12, 4)
  notes            String?
  performed_by     String?  @db.Uuid
  created_at       DateTime @default(now())

  product       Product            @relation(fields: [product_id], references: [id])
  variant       ProductVariant?    @relation(fields: [variant_id], references: [id])
  from_location WarehouseLocation? @relation("inv_tx_from", fields: [from_location_id], references: [id])
  to_location   WarehouseLocation? @relation("inv_tx_to", fields: [to_location_id], references: [id])

  @@index([tenant_id, product_id])
  @@index([tenant_id, created_at(sort: Desc)])
  @@map("inventory_transactions")
}

// =====================
// FIFO BATCH LEDGER
// =====================

model InventoryBatch {
  id           String   @id @default(uuid()) @db.Uuid
  tenant_id    String   @db.Uuid
  product_id   String   @db.Uuid
  variant_id   String?  @db.Uuid
  location_id  String   @db.Uuid
  source_po_id String?  @db.Uuid // which PO created this batch
  po_number    String? // human-readable "PO-2026-00004"
  quantity     Int // remaining quantity in this batch
  unit_cost    Decimal  @default(0) @db.Decimal(14, 4)
  received_at  DateTime @default(now())
  created_at   DateTime @default(now())

  product  Product           @relation(fields: [product_id], references: [id])
  variant  ProductVariant?   @relation(fields: [variant_id], references: [id])
  location WarehouseLocation @relation(fields: [location_id], references: [id])

  @@index([tenant_id, product_id, variant_id, received_at(sort: Asc)])
  @@map("inventory_batches")
}

// =====================
// WAREHOUSE WORK
// =====================

model WorkTemplate {
  id           String   @id @default(uuid()) @db.Uuid
  tenant_id    String   @db.Uuid
  code         String
  name         String
  work_type    String
  warehouse_id String   @db.Uuid
  is_active    Boolean  @default(true)
  created_at   DateTime @default(now())

  warehouse Warehouse          @relation(fields: [warehouse_id], references: [id])
  lines     WorkTemplateLine[]

  @@unique([tenant_id, code])
  @@map("work_templates")
}

model WorkTemplateLine {
  id            String  @id @default(uuid()) @db.Uuid
  template_id   String  @db.Uuid
  sequence      Int
  work_type     String
  location_type String?
  sort_order    Int     @default(0)

  template WorkTemplate @relation(fields: [template_id], references: [id], onDelete: Cascade)

  @@map("work_template_lines")
}

model LocationDirective {
  id             String   @id @default(uuid()) @db.Uuid
  tenant_id      String   @db.Uuid
  code           String
  name           String
  directive_type String
  warehouse_id   String   @db.Uuid
  work_type      String
  sequence       Int
  is_active      Boolean  @default(true)
  created_at     DateTime @default(now())

  warehouse Warehouse               @relation(fields: [warehouse_id], references: [id])
  lines     LocationDirectiveLine[]

  @@unique([tenant_id, code])
  @@map("location_directives")
}

model LocationDirectiveLine {
  id           String   @id @default(uuid()) @db.Uuid
  directive_id String   @db.Uuid
  sequence     Int
  from_qty     Decimal  @default(0) @db.Decimal(12, 2)
  to_qty       Decimal? @db.Decimal(12, 2)
  strategy     String   @default("CONSOLIDATE")
  zone_id      String?  @db.Uuid
  location_id  String?  @db.Uuid

  directive LocationDirective  @relation(fields: [directive_id], references: [id], onDelete: Cascade)
  zone      WarehouseZone?     @relation(fields: [zone_id], references: [id])
  location  WarehouseLocation? @relation(fields: [location_id], references: [id])

  @@map("location_directive_lines")
}

model WaveTemplate {
  id           String   @id @default(uuid()) @db.Uuid
  tenant_id    String   @db.Uuid
  code         String
  name         String
  warehouse_id String   @db.Uuid
  wave_type    String   @default("SHIPPING")
  auto_process Boolean  @default(false)
  auto_release Boolean  @default(false)
  created_at   DateTime @default(now())

  warehouse Warehouse @relation(fields: [warehouse_id], references: [id])

  @@unique([tenant_id, code])
  @@map("wave_templates")
}

model Wave {
  id           String    @id @default(uuid()) @db.Uuid
  tenant_id    String    @db.Uuid
  template_id  String?   @db.Uuid
  warehouse_id String    @db.Uuid
  status       String    @default("OPEN")
  created_at   DateTime  @default(now())
  released_at  DateTime?
  completed_at DateTime?

  warehouse    Warehouse       @relation(fields: [warehouse_id], references: [id])
  work         WarehouseWork[]
  sales_orders SalesOrder[]

  @@map("waves")
}

model WarehouseWork {
  id             String    @id @default(uuid()) @db.Uuid
  tenant_id      String    @db.Uuid
  work_id_code   String    @unique
  work_type      String
  status         String    @default("OPEN")
  wave_id        String?   @db.Uuid
  warehouse_id   String    @db.Uuid
  assigned_to    String?   @db.Uuid
  reference_type String?
  reference_id   String?   @db.Uuid
  priority       Int       @default(5)
  started_at     DateTime?
  completed_at   DateTime?
  created_at     DateTime  @default(now())

  wave      Wave?               @relation(fields: [wave_id], references: [id])
  warehouse Warehouse           @relation(fields: [warehouse_id], references: [id])
  lines     WarehouseWorkLine[]

  @@index([tenant_id, status])
  @@map("warehouse_work")
}

model WarehouseWorkLine {
  id               String    @id @default(uuid()) @db.Uuid
  work_id          String    @db.Uuid
  sequence         Int
  line_type        String
  product_id       String    @db.Uuid
  variant_id       String?   @db.Uuid
  quantity         Decimal   @db.Decimal(12, 2)
  quantity_done    Decimal   @default(0) @db.Decimal(12, 2)
  from_location_id String?   @db.Uuid
  to_location_id   String?   @db.Uuid
  status           String    @default("PENDING")
  completed_at     DateTime?

  work          WarehouseWork      @relation(fields: [work_id], references: [id], onDelete: Cascade)
  product       Product            @relation(fields: [product_id], references: [id])
  from_location WarehouseLocation? @relation("from_location", fields: [from_location_id], references: [id])
  to_location   WarehouseLocation? @relation("to_location", fields: [to_location_id], references: [id])

  @@map("warehouse_work_lines")
}

model ArrivalJournal {
  id                String    @id @default(uuid()) @db.Uuid
  tenant_id         String    @db.Uuid
  journal_number    String    @unique
  purchase_order_id String?   @db.Uuid
  warehouse_id      String    @db.Uuid
  status            String    @default("DRAFT")
  arrival_date      DateTime  @default(now()) @db.Date
  notes             String?
  created_by        String?   @db.Uuid
  posted_at         DateTime?
  created_at        DateTime  @default(now())

  warehouse      Warehouse            @relation(fields: [warehouse_id], references: [id])
  purchase_order PurchaseOrder?       @relation(fields: [purchase_order_id], references: [id])
  lines          ArrivalJournalLine[]

  @@map("arrival_journals")
}

model ArrivalJournalLine {
  id                  String   @id @default(uuid()) @db.Uuid
  journal_id          String   @db.Uuid
  product_id          String   @db.Uuid
  variant_id          String?  @db.Uuid
  expected_qty        Decimal? @db.Decimal(12, 2)
  received_qty        Decimal  @default(0) @db.Decimal(12, 2)
  receive_location_id String?  @db.Uuid

  journal ArrivalJournal @relation(fields: [journal_id], references: [id], onDelete: Cascade)

  @@map("arrival_journal_lines")
}

// =====================
// SUPPLIERS & PURCHASE
// =====================

model Supplier {
  id            String   @id @default(uuid()) @db.Uuid
  tenant_id     String   @db.Uuid
  code          String
  name          String
  contact_name  String?
  email         String?
  phone         String?
  address       String?
  city          String?
  country       String?
  payment_terms Int?     @default(30)
  currency      String   @default("BOB")
  /// Party side of the tax intersection. Nullable — falls back to the default on
  /// PurchaseParameters/SalesParameters when unset, which is how existing rows keep
  /// working unchanged.
  tax_group_id  String?  @db.Uuid
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  purchase_orders   PurchaseOrder[]
  tax_group         TaxGroup?                 @relation(fields: [tax_group_id], references: [id])
  rfq_requests      RfqRequest[]
  preferred_on_req  PurchaseRequisitionLine[] @relation("preferred_supplier")

  @@unique([tenant_id, code])
  @@map("suppliers")
}

model PurchaseOrder {
  id                  String    @id @default(uuid()) @db.Uuid
  tenant_id           String    @db.Uuid
  po_number           String    @unique
  supplier_id         String    @db.Uuid
  warehouse_id        String    @db.Uuid
  status              String    @default("DRAFT")
  order_date          DateTime  @default(now()) @db.Date
  expected_date       DateTime? @db.Date
  currency            String    @default("TRY")
  subtotal            Decimal   @default(0) @db.Decimal(14, 2)
  tax_amount          Decimal   @default(0) @db.Decimal(14, 2)
  total_amount        Decimal   @default(0) @db.Decimal(14, 2)
  notes               String?
  created_by          String?   @db.Uuid
  confirmed_at        DateTime?
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt
  receive_location_id String?   @db.Uuid
  received_at         DateTime?
  received_by         String?   @db.Uuid
  packing_slip_url    String?
  paid_at             DateTime?
  paid_by             String?   @db.Uuid

  /// ── Document provenance (Source to Pay upstream) ────────────────────────
  /// Where this order came from. `DIRECT` means somebody raised the PO itself,
  /// which is how every historical row and every counter purchase behaves.
  ///
  /// This is deliberately a polymorphic (type, id) pair rather than a set of
  /// nullable FKs, because the set of upstream documents is genuinely open:
  /// REQUISITION and RFQ exist today, PURCHASE_AGREEMENT and PLANNED_ORDER are
  /// documented deferrals (SCOPE_AND_HOOKS.md §2). A new origin is a new enum
  /// value, not a migration.
  ///
  /// DIRECT | REQUISITION | RFQ | PURCHASE_AGREEMENT | PLANNED_ORDER
  source_document_type String  @default("DIRECT")
  source_document_id   String? @db.Uuid

  supplier         Supplier            @relation(fields: [supplier_id], references: [id])
  warehouse        Warehouse           @relation(fields: [warehouse_id], references: [id])
  lines            PurchaseOrderLine[]
  arrival_journals ArrivalJournal[]

  @@index([tenant_id, source_document_type, source_document_id])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id           String  @id @default(uuid()) @db.Uuid
  po_id        String  @db.Uuid
  product_id   String  @db.Uuid
  variant_id   String? @db.Uuid
  quantity     Decimal @db.Decimal(12, 2)
  received_qty Decimal @default(0) @db.Decimal(12, 2)
  unit_cost    Decimal @db.Decimal(12, 4)
  line_total   Decimal @db.Decimal(14, 2)
  sort_order   Int     @default(0)

  /// Line-level tax — the hook for multi-rate jurisdictions.
  /// Bolivia has one rate, so tax is computed on the document total today and
  /// these stay null. Turkey (KDV 20/10/1) and Germany (USt 19/7) cannot be
  /// represented that way: an order holding one standard-rated and one
  /// reduced-rate product has no single header rate. These columns exist now so
  /// that refactor is a service change, not a migration against live orders.
  item_tax_group_id String?  @db.Uuid
  tax_amount        Decimal? @db.Decimal(14, 2)
  tax_base          Decimal? @db.Decimal(14, 2)

  /// Line-level provenance. The HEADER link is not sufficient on the purchase
  /// side: **[OFFICIAL]** an RFQ award may accept lines from several vendors
  /// ("You can also accept lines from different vendors" —
  /// learn.microsoft.com/dynamics365/supply-chain/procurement/request-quotations),
  /// and a purchase order carries exactly one supplier. One RFQ case therefore
  /// fans out into several POs, and only the line records which bid line it was
  /// awarded from. Without this column the award audit trail is unreconstructable.
  ///
  /// Points at `rfq_request_lines.id` or `purchase_requisition_lines.id`, per the
  /// header's `source_document_type`. Not an FK for the same reason the header
  /// pair is not.
  source_line_id    String?  @db.Uuid
  /// Hook only — purchase agreements are deferred (SCOPE_AND_HOOKS.md §2), and
  /// the documented requirement is that consumption against a commitment must be
  /// traceable at line level or agreement fulfilment cannot be computed from
  /// history. Nothing reads it yet.
  agreement_line_id String?  @db.Uuid

  purchase_order PurchaseOrder @relation(fields: [po_id], references: [id], onDelete: Cascade)
  product        Product       @relation(fields: [product_id], references: [id])

  @@map("purchase_order_lines")
}

// =====================
// CUSTOMERS & SALES
// =====================

model Customer {
  id             String    @id @default(uuid()) @db.Uuid
  tenant_id      String    @db.Uuid
  user_id        String?   @db.Uuid
  code           String
  first_name     String
  last_name      String
  email          String?
  phone          String?
  address        String?
  city           String?
  country        String?
  date_of_birth  DateTime? @db.Date
  segment        String    @default("regular")
  tags           String[]
  notes          String?
  lifetime_value Decimal   @default(0) @db.Decimal(14, 2)
  total_orders   Int       @default(0)
  /// Party side of the tax intersection — see the TAX ENGINE section. Nullable, so
  /// every existing customer keeps the SalesParameters default until classified.
  tax_group_id   String?   @db.Uuid
  /// NIT in Bolivia, VKN/TCKN in Turkey, USt-IdNr in Germany. A validated EU VAT ID
  /// is what makes an intra-community supply exempt, so this is a tax field, not a
  /// contact field.
  tax_id         String?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  sales_orders    SalesOrder[]
  tax_group       TaxGroup?       @relation(fields: [tax_group_id], references: [id])
  converted_from  Lead[]          @relation("converted_customer")
  opportunities   Opportunity[]
  quotations      SalesQuotation[]

  @@unique([tenant_id, code])
  @@map("customers")
}

model SalesOrder {
  id               String    @id @default(uuid()) @db.Uuid
  tenant_id        String    @db.Uuid
  order_number     String    @unique
  customer_id      String?   @db.Uuid
  source           String    @default("manual")
  status           String    @default("DRAFT")
  site_id          String?   @db.Uuid
  warehouse_id     String?   @db.Uuid
  currency         String    @default("BOB")
  subtotal         Decimal   @default(0) @db.Decimal(14, 2)
  discount_amount  Decimal   @default(0) @db.Decimal(14, 2)
  tax_amount       Decimal   @default(0) @db.Decimal(14, 2)
  total_amount     Decimal   @default(0) @db.Decimal(14, 2)
  shipping_address Json?
  notes            String?
  wave_id          String?   @db.Uuid
  invoice_id       String?   @db.Uuid // soft ref to Factura — set when invoiced
  paid_at          DateTime?
  paid_by          String?   @db.Uuid
  returned_at      DateTime?
  created_by       String?   @db.Uuid
  confirmed_at     DateTime?
  shipped_at       DateTime?
  completed_at     DateTime?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  /// ── Document provenance (Prospect to Quote upstream) ────────────────────
  /// Mirrors `PurchaseOrder.source_document_type`. `DIRECT` is every historical
  /// row and every counter sale.
  ///
  /// Note this is NOT the same axis as the existing `source` column, which
  /// records the CHANNEL the order was captured through (manual / storefront /
  /// import / pos). An order can be `source = storefront` and
  /// `source_document_type = QUOTATION` at the same time. Channel and provenance
  /// are independent facts and collapsing them would lose one of them.
  ///
  /// DIRECT | QUOTATION | OPPORTUNITY | SALES_AGREEMENT | SUBSCRIPTION
  source_document_type String  @default("DIRECT")
  source_document_id   String? @db.Uuid

  customer        Customer?        @relation(fields: [customer_id], references: [id])
  site            Site?            @relation(fields: [site_id], references: [id])
  warehouse       Warehouse?       @relation(fields: [warehouse_id], references: [id])
  wave            Wave?            @relation(fields: [wave_id], references: [id])
  lines           SalesOrderLine[]
  shipments       Shipment[]
  created_by_user User?            @relation("created_by", fields: [created_by], references: [id])
  from_quotations SalesQuotation[] @relation("converted_order")

  @@index([tenant_id, status])
  @@index([tenant_id, created_at(sort: Desc)])
  @@index([tenant_id, source_document_type, source_document_id])
  @@map("sales_orders")
}

model SalesOrderLine {
  id           String  @id @default(uuid()) @db.Uuid
  order_id     String  @db.Uuid
  product_id   String  @db.Uuid
  variant_id   String? @db.Uuid
  quantity     Int
  unit_price   Decimal @db.Decimal(12, 4)
  discount_pct Decimal @default(0) @db.Decimal(5, 2)
  line_total   Decimal @db.Decimal(14, 2)
  sort_order   Int     @default(0)

  /// Line-level tax — the hook for multi-rate jurisdictions.
  /// Bolivia has one rate, so tax is computed on the document total today and
  /// these stay null. Turkey (KDV 20/10/1) and Germany (USt 19/7) cannot be
  /// represented that way: an order holding one standard-rated and one
  /// reduced-rate product has no single header rate. These columns exist now so
  /// that refactor is a service change, not a migration against live orders.
  item_tax_group_id String?  @db.Uuid
  tax_amount        Decimal? @db.Decimal(14, 2)
  tax_base          Decimal? @db.Decimal(14, 2)

  /// Line-level provenance — points at `sales_quotation_lines.id` when the order
  /// was confirmed from a quotation. Symmetrical with
  /// `PurchaseOrderLine.source_line_id`, and it is what makes partial conversion
  /// ("order three of the five quoted lines") reconstructable.
  source_line_id String? @db.Uuid

  order   SalesOrder @relation(fields: [order_id], references: [id], onDelete: Cascade)
  product Product    @relation(fields: [product_id], references: [id])

  @@map("sales_order_lines")
}

