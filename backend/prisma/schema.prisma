// INVENTORY COUNTING
// =====================

model InventoryCount {
  id           String    @id @default(uuid()) @db.Uuid
  tenant_id    String    @db.Uuid
  reference    String    @unique
  status       String    @default("DRAFT")
  notes        String?
  counted_by   String?   @db.Uuid
  created_at   DateTime  @default(now())
  finalized_at DateTime?

  lines InventoryCountLine[]

  @@map("inventory_counts")
}

model InventoryCountLine {
  id          String  @id @default(uuid()) @db.Uuid
  count_id    String  @db.Uuid
  product_id  String  @db.Uuid
  variant_id  String? @db.Uuid
  location_id String  @db.Uuid
  system_qty  Int     @default(0)
  counted_qty Int?

  count    InventoryCount    @relation(fields: [count_id], references: [id], onDelete: Cascade)
  product  Product           @relation(fields: [product_id], references: [id])
  variant  ProductVariant?   @relation(fields: [variant_id], references: [id])
  location WarehouseLocation @relation(fields: [location_id], references: [id])

  @@map("inventory_count_lines")
