// =====================
// CONFIGURATION FOUNDATION
// Design: docs/architecture/PARAMETERS_AND_CONFIG.md
//
// Three distinct configuration classes, deliberately NOT merged into one table:
//   posting_profiles  — resolution matrix : which GL account
//   number_sequences  — document numbering : which series, gapless or not
//   *_parameters      — singleton per scope : defaults and functional switches
//
// `legal_entity_id` is nullable on every table here and is the forward hook for a
// tenant that later operates more than one legal company (two SRLs under one owner
// is ordinary in Bolivia, and each has its own NIT and factura authorisation).
// NULL means "tenant-wide default". No LegalEntity table exists yet — the column is
// the part that is expensive to add later, the table is not.
// =====================

/// Resolves a posting type to a GL account, most-specific-first, the way D365
/// posting profiles and price tolerances do (Table → Group → All).
/// Replaces hardcoded account-code literals in the posting routes, which are the
/// root cause of defects D-1…D-7 (docs/process/GAP_ANALYSIS.md).
model PostingProfile {
  id              String  @id @default(uuid()) @db.Uuid
  tenant_id       String  @db.Uuid
  legal_entity_id String? @db.Uuid

  /// AR, AP, REVENUE, VAT_OUTPUT, VAT_INPUT, COGS, INVENTORY,
  /// TAX_TURNOVER_EXPENSE, TAX_TURNOVER_PAYABLE, CASH, BANK, ROUNDING
  posting_type String
  /// ALL | ITEM_GROUP | ITEM | PARTY_GROUP | PARTY — the specificity axis.
  /// ALL is mandatory per posting_type and acts as the fallback; D365 likewise
  /// forbids deleting the All/All default.
  scope_kind   String  @default("ALL")
  /// Null when scope_kind = ALL. Not an FK: the target table depends on scope_kind.
  scope_id     String? @db.Uuid

  account_id String @db.Uuid

  /// Date-effective so a chart-of-accounts change is a new row, never an update
  /// that silently repoints history.
  valid_from DateTime  @db.Date
  valid_to   DateTime? @db.Date

  description String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  account Account @relation(fields: [account_id], references: [id])

  /// Postgres treats NULLs as distinct in unique constraints, which would let
  /// duplicate ALL-scope rows through. The migration replaces this with the same
  /// index declared NULLS NOT DISTINCT (Postgres 15+; Supabase runs 17.6).
  @@unique([tenant_id, legal_entity_id, posting_type, scope_kind, scope_id, valid_from])
  @@index([tenant_id, posting_type, scope_kind])
  @@map("posting_profiles")
}

/// Document numbering framework. D365 splits the sequence definition (Organization
/// administration) from the module binding (parameters page); this is the definition
/// half — `reference` is the binding.
/// Fixes D-5: two ad-hoc series currently share one globally-unique column.
model NumberSequence {
  id              String  @id @default(uuid()) @db.Uuid
  tenant_id       String  @db.Uuid
  legal_entity_id String? @db.Uuid

  /// FACTURA, CREDIT_NOTE, JOURNAL_VOUCHER, SALES_ORDER, PURCHASE_ORDER,
  /// INVENTORY_ADJUSTMENT, TRANSFER, PRODUCT_RECEIPT, VENDOR_INVOICE, PAYMENT
  reference String
  name      String

  /// Segment format. {YYYY} = year, {LE} = legal entity code, {#####} = padded counter.
  /// e.g. "JE-{YYYY}-{#####}" or "F-{######}"
  format String

  /// Gapless. Legally required for some documents in some jurisdictions — the
  /// Bolivian factura series is the open question (HANDOVER.md §7). Continuous
  /// allocation must hold a row lock until the caller's transaction commits, which
  /// is why this is a per-sequence choice and not a global policy.
  continuous Boolean @default(false)

  /// SHARED | LEGAL_ENTITY | FISCAL_YEAR — controls when the counter restarts.
  scope String @default("LEGAL_ENTITY")

  next_number  Int  @default(1)
  /// Set when scope = FISCAL_YEAR; the counter resets when the year rolls over.
  current_year Int?

  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  /// Deferred, and it needs no hook here: gap justification for a continuous
  /// sequence is a separate table keyed on (number_sequence_id, number) and can be
  /// added without touching this one.
  @@unique([tenant_id, legal_entity_id, reference])
  @@map("number_sequences")
}

/// Module parameters — one wide, typed, singleton row per scope per module.
/// Deliberately four typed tables rather than one generic settings(key, value):
/// an EAV blob is how two rival tax configurations came to coexist unnoticed
/// (Tenant.tax_config vs config/tax.ts vs the COA template).

model FinanceParameters {
  id              String  @id @default(uuid()) @db.Uuid
  tenant_id       String  @db.Uuid
  legal_entity_id String? @db.Uuid

  /// Hard-fail a document whose journal cannot post, instead of creating it with
  /// no GL entry. Fixes D-4. Defaults true; exists as a switch only so an existing
  /// tenant can be migrated deliberately rather than abruptly.
  require_balanced_posting       Boolean @default(true)
  allow_posting_to_closed_period Boolean @default(false)

  functional_currency String  @default("BOB")
  /// Rounding tolerance below which a posting imbalance is written to ROUNDING
  /// rather than rejected.
  rounding_tolerance  Decimal @default(0.02) @db.Decimal(14, 2)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([tenant_id, legal_entity_id])
  @@map("finance_parameters")
}

model SalesParameters {
  id              String  @id @default(uuid()) @db.Uuid
  tenant_id       String  @db.Uuid
  legal_entity_id String? @db.Uuid

  /// Tax rates are deliberately NOT columns here. They live on TaxCode and are
  /// resolved through the group ∩ item-group intersection — see the TAX ENGINE
  /// section for why a rate column on this table cannot represent Turkey or
  /// Germany. What belongs here is the DEFAULT used when a party or a product
  /// carries no group of its own.
  default_tax_group_id      String? @db.Uuid
  default_item_tax_group_id String? @db.Uuid

  /// Presentation only. The legal document name differs per jurisdiction
  /// (Factura / Fatura / Rechnung); it is not a tax rule.
  invoice_label String @default("Factura")

  allow_negative_inventory_sale Boolean @default(false)
  require_customer_tax_id       Boolean @default(false)

  /// ── Prospect to Quote switches ─────────────────────────────────────────
  /// The upstream chain is Lead → Opportunity → Quotation → Order, and EVERY
  /// step of it is optional. These switches are how a tenant declares which
  /// steps its own process actually uses, so that turning the CRM stage on or
  /// off is configuration rather than a code branch. The anchor customer sells
  /// shoes across a counter and uses none of them; a B2B/wholesale tenant will
  /// use all of them.
  ///
  /// Default validity window for a new quotation. Business Central expresses the
  /// same idea as "Quote Validity Calculation" on Sales & Receivables Setup.
  quotation_validity_days          Int     @default(30)
  /// Force every quotation to hang off an opportunity. False by default —
  /// requiring it would make the simple "quote a walk-in customer" case
  /// two documents long.
  require_opportunity_for_quotation Boolean @default(false)
  /// Whether confirming a quotation raised for a LEAD may create the customer
  /// record automatically. D365 makes this an explicit "Convert to customer"
  /// step first; for an SME product the extra click buys nothing, but a tenant
  /// that wants master-data control can turn it off and be forced to convert
  /// deliberately.
  auto_convert_lead_on_confirm     Boolean @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  default_tax_group      TaxGroup?     @relation(fields: [default_tax_group_id], references: [id])
  default_item_tax_group ItemTaxGroup? @relation(fields: [default_item_tax_group_id], references: [id])

  @@unique([tenant_id, legal_entity_id])
  @@map("sales_parameters")
}

model PurchaseParameters {
  id              String  @id @default(uuid()) @db.Uuid
  tenant_id       String  @db.Uuid
  legal_entity_id String? @db.Uuid

  /// NONE | TWO_WAY | THREE_WAY — mirrors the D365 line matching policy. NONE
  /// today because the vendor invoice document does not exist yet; the column is
  /// the hook so enabling matching later is configuration, not a migration.
  line_matching_policy String  @default("NONE")
  price_tolerance_pct  Decimal @default(0) @db.Decimal(6, 4)

  /// Whether input IVA is recognised at product receipt or at the vendor factura.
  /// Skarpine recognises at receipt today; whether Bolivian law permits that is an
  /// open question (P2P_REFERENCE.md §7). A switch, not a rewrite, once answered.
  vat_input_recognition String @default("RECEIPT") // RECEIPT | INVOICE

  /// ── Source to Pay upstream switches ────────────────────────────────────
  /// Same principle as the sales side: Requisition → RFQ → Purchase Order, all
  /// steps optional, declared per tenant instead of branched in code.
  ///
  /// When true, a purchase order may only be raised from an approved
  /// requisition or an awarded RFQ. False by default — the anchor customer's
  /// owner decides and buys, and forcing an internal requisition on a
  /// three-store retailer is exactly the enterprise ceremony this product is
  /// meant to avoid.
  require_requisition_for_po Boolean @default(false)
  /// Whether an approval step exists at all. When false, a submitted
  /// requisition is approved immediately — the D365 "automatically approve"
  /// workflow configuration, expressed as a parameter rather than a workflow
  /// engine. A real workflow engine is deliberately NOT built: at ≤50 employees
  /// the approver is one person.
  requisition_approval_enabled   Boolean  @default(true)
  /// Requisitions at or below this estimated total skip approval. NULL means no
  /// threshold, so every requisition needs approval when approval is enabled.
  requisition_approval_threshold Decimal? @db.Decimal(14, 2)
  /// Default number of days a vendor has to respond to an RFQ. Presentation of
  /// the deadline only — nothing expires automatically.
  rfq_response_days Int @default(7)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([tenant_id, legal_entity_id])
  @@map("purchase_parameters")
}

model InventoryParameters {
  id              String  @id @default(uuid()) @db.Uuid
  tenant_id       String  @db.Uuid
  legal_entity_id String? @db.Uuid

  /// FIFO | WEIGHTED_AVG | STANDARD. FIFO matches the batch-level unit_cost the
  /// code already keeps. Changing this on a live tenant is not a supported
  /// operation and the service layer must refuse it once transactions exist.
  costing_method           String  @default("FIFO")
  allow_negative_inventory Boolean @default(false)
  /// Landed cost is deferred. The hook is on the batch, not here — this flag only
  /// controls whether the allocation step runs.
  capitalise_landed_cost   Boolean @default(false)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([tenant_id, legal_entity_id])
  @@map("inventory_parameters")
}

// =====================
// TAX ENGINE
//
// WHY THIS EXISTS, AND WHY A RATE COLUMN WAS NOT ENOUGH
//
// The first cut of SalesParameters held `vat_rate` and `turnover_tax_rate` as
// columns. That is Bolivia's shape parameterised, not a tax engine, and it breaks
// the moment the product is sold anywhere else:
//
//   Bolivia  IVA 13% price-INCLUSIVE, plus IT 3% — a turnover tax that is NOT
//            recoverable and exists on the sales side only.
//   Turkey   KDV at 20% / 10% / 1% CONCURRENTLY, plus *tevkifat*: partial
//            withholding where the BUYER remits a share of the VAT, above a
//            statutory invoice threshold, and only for designated withholding
//            agents. One rate column cannot say "20%, of which the buyer remits
//            half".
//   Germany  USt 19% / 7%, plus reverse charge (§13b) where the customer accounts
//            for the tax entirely, plus intra-community supply which is exempt but
//            still must be reported and carries a legal reference on the invoice.
//
// The model below is D365's: a tax code carries the rate and the rules; a tax
// group hangs off the PARTY and an item tax group off the PRODUCT; the codes that
// appear in BOTH are the codes that apply.
//
//   "Both groups contain a list of sales tax codes, and the intersection of the
//    two lists of sales tax codes determines the list of applicable sales tax
//    codes for the transaction."
//   — learn.microsoft.com/dynamics365/finance/general-ledger/indirect-taxes-overview
//
// That intersection is what lets one schema carry all three jurisdictions:
// zero-rated exports, exempt intra-EU supply, reverse charge and multi-rate VAT
// are all "which codes intersect", not "which if-branch runs".
//
// Bolivia stays the default. It becomes a configured jurisdiction, not one of
// several equals with regressions.
// =====================

/// A single tax with its rate and calculation rules. The unit of configuration.
model TaxCode {
  id              String  @id @default(uuid()) @db.Uuid
  tenant_id       String  @db.Uuid
  legal_entity_id String? @db.Uuid

  code String /// IVA13, IT3, KDV20, KDV20TEV5, UST19, UST0EU
  name String

  /// VAT | TURNOVER | WITHHOLDING | EXCISE | EXEMPT
  /// TURNOVER is what makes Bolivia's IT representable: a sales-side,
  /// non-recoverable tax that must never appear in a VAT netting report.
  tax_type String @default("VAT")

  rate Decimal @db.Decimal(9, 6)

  /// Does the quoted price already contain this tax? Bolivia's IVA is quoted
  /// inside the price; Turkish and German VAT are added on top. Per code, not per
  /// tenant — a jurisdiction can have both.
  is_inclusive Boolean @default(false)

  /// WHAT THE RATE MULTIPLIES. Orthogonal to `is_inclusive`, and the distinction
  /// is not academic — it was worth 1,5 points of tax on every Bolivian invoice.
  ///
  ///   NET    rate × (amount excluding this tax).  The international norm, and
  ///          what Turkish KDV, German USt and Bolivia AFTER Ley 1733 do.
  ///   GROSS  rate × (amount INCLUDING this tax).  Bolivia's *IVA por dentro*.
  ///
  /// **[OFFICIAL]** Ley 843 art. 5: "El impuesto de este Título forma parte
  /// integrante del precio neto de la venta […] y se facturará juntamente con
  /// éste, es decir, no se mostrará por separado." Art. 7 then applies the
  /// alícuota to "los importes totales de los precios netos" — a base that, by
  /// art. 5, already contains the tax. Hence the well-known Bolivian pair:
  /// nominal rate 13%, EFFECTIVE rate 13/(1−0,13) = 14,9425% of the true net.
  ///
  /// The engine originally computed `gross − gross/1,13` for every inclusive
  /// code, which is the EXTRACT arithmetic — correct for a tax-inclusive price
  /// elsewhere in the world, and 11,50% rather than 13,00% of gross in Bolivia.
  ///
  /// Bolivia's IT is also GROSS: art. 74 sets the base as "los ingresos brutos
  /// devengados […] el valor o monto total […] devengados en concepto de venta
  /// de bienes", which is the invoiced amount, not the amount after IVA.
  ///
  /// **Ley 1733 (27 May 2026) changes this**, moving Bolivia to IVA *por fuera*
  /// at a real 13%. Its IVA articles take effect only from the first day of the
  /// month following publication of the reglamentary Decreto Supremo. Because
  /// `TaxCode` is date-effective, that transition is a NEW ROW with
  /// `base_kind = NET`, `is_inclusive = false` and the right `valid_from` — not
  /// a migration and not a code change. See docs/process/BOLIVIA_TAX_BASIS.md.
  base_kind String @default("NET")

  /// Input tax that can be reclaimed (IVA crédito fiscal, Vorsteuer, indirilecek
  /// KDV). False for Bolivia's IT, which is a cost, not a receivable.
  is_recoverable Boolean @default(true)

  /// DOMESTIC | EU | THIRD — mirrors the D365 country/region type, which is how
  /// intra-community versus export treatment is distinguished for EU reporting.
  region_type String @default("DOMESTIC")

  /// Germany §13b and the EU B2B mechanism: the customer accounts for the tax, so
  /// the supplier calculates it but posts no liability.
  reverse_charge Boolean @default(false)

  is_exempt     Boolean @default(false)
  /// Legal reference printed on the invoice when exempt or reverse charged
  /// (e.g. "§6a UStG", "§13b UStG"). Required for a valid German invoice.
  exempt_reason String?

  /// Turkish tevkifat: the share of the calculated tax the BUYER remits directly,
  /// applied only when the document total reaches `withholding_threshold`.
  /// Null everywhere else. Modelled as a share rather than a separate code so the
  /// invoice can print the split the way a tevkifatlı fatura must.
  withholding_share     Decimal? @db.Decimal(9, 6)
  withholding_threshold Decimal? @db.Decimal(14, 2)

  /// GL routing — reuses the posting profile mechanism rather than duplicating
  /// account configuration. These are PostingProfile.posting_type values, so a tax
  /// code never names a GL account directly.
  posting_type_payable    String  @default("VAT_OUTPUT")
  posting_type_receivable String? @default("VAT_INPUT")

  /// Hook only. Settlement periods (monthly Turkish return due the 26th, German
  /// Voranmeldung, Bolivian monthly IVA) are deferred; the table attaches here
  /// without touching this one.
  settlement_period_id String? @db.Uuid

  valid_from DateTime  @db.Date
  valid_to   DateTime? @db.Date
  is_active  Boolean   @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tax_group_codes      TaxGroupCode[]
  item_tax_group_codes ItemTaxGroupCode[]

  @@unique([tenant_id, legal_entity_id, code, valid_from])
  @@index([tenant_id, is_active])
  @@map("tax_codes")
}

/// Attached to the PARTY — customer or supplier. Answers "who are we trading with"
/// (domestic, EU business with a validated VAT ID, export, withholding agent).
model TaxGroup {
  id              String  @id @default(uuid()) @db.Uuid
  tenant_id       String  @db.Uuid
  legal_entity_id String? @db.Uuid

  code        String
  name        String
  description String?
  is_active   Boolean @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  codes               TaxGroupCode[]
  customers           Customer[]
  suppliers           Supplier[]
  sales_param_default SalesParameters[]

  @@unique([tenant_id, legal_entity_id, code])
  @@map("tax_groups")
}

/// Attached to the PRODUCT. Answers "what are we selling" (standard rated, reduced
/// rate, exempt, subject to withholding).
model ItemTaxGroup {
  id              String  @id @default(uuid()) @db.Uuid
  tenant_id       String  @db.Uuid
  legal_entity_id String? @db.Uuid

  code        String
  name        String
  description String?
  is_active   Boolean @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  codes               ItemTaxGroupCode[]
  products            Product[]
  sales_param_default SalesParameters[]

  @@unique([tenant_id, legal_entity_id, code])
  @@map("item_tax_groups")
}

model TaxGroupCode {
  tax_group_id String @db.Uuid
  tax_code_id  String @db.Uuid

  tax_group TaxGroup @relation(fields: [tax_group_id], references: [id], onDelete: Cascade)
  tax_code  TaxCode  @relation(fields: [tax_code_id], references: [id], onDelete: Cascade)

  @@id([tax_group_id, tax_code_id])
  @@map("tax_group_codes")
}

// =====================
// RELEASED PRODUCT SETUP — item group and item model group
// Design: docs/architecture/ERP_SETUP_CHECKLIST.md
//
// **[OFFICIAL]** creating a released product in D365 requires, in this order:
// product number, name, **item model group**, **item group**, storage dimension
// group, tracking dimension group, inventory unit.
// learn.microsoft.com/dynamics365/supply-chain/pim/tasks/create-released-product-single-company
//
// Two of those are financial and neither existed here. They answer different
// questions and are routinely confused:
//
//   ITEM MODEL GROUP  — HOW is this item valued and controlled?
//                       costing method, is it stocked at all, does a physical or
//                       financial update hit the ledger.
//   ITEM GROUP        — WHERE does its money go?
//                       the GL accounts, via the posting profile matrix.
//
// **[OFFICIAL]** on the item group: "to manage how information is posted to main
// accounts, create a series of different item groups that are associated with
// specific main accounts."
//
// **[OFFICIAL]** on the item model group: "You can select only one costing model
// for each released product. The item model group controls this behavior."
// learn.microsoft.com/dynamics365/supply-chain/cost-management/inventory-costing-faq
//
// ── Why this matters here specifically ─────────────────────────────────────
// `PostingProfile.scope_kind` has accepted 'ITEM_GROUP' since migration 001 and
// `postingProfile.service.ts` resolves `ctx.itemGroupId` — but nothing could ever
// supply one, because no item group existed. The most useful axis of the posting
// matrix was unreachable. This makes it real.
//
// Costing method was likewise a single tenant-wide switch on
// `InventoryParameters.costing_method`, which cannot express "footwear is FIFO,
// packaging is weighted average" — and Microsoft is explicit that the choice is
// per released product, through this group.
// =====================

/// HOW an item is valued and controlled.
///
/// ── EVERY SETTING BELOW IS INDEPENDENT OF EVERY OTHER ──────────────────────
/// The first cut of this model shipped two seeded groups, `FIFO` (stocked) and
/// `SERVICE` (standard cost, not stocked), which made the setup screen imply
/// that choosing STANDARD costing meant declaring the item a service. That is
/// simply false, and Microsoft says so twice:
///
///   "**Yes, you can use different costing models for each item.** It's common
///    for manufacturers to use a periodic costing model for raw materials and
///    standard cost for semi-finished and finished goods."
///
///   "enable the **Accrue liability on product receipt** option for all item
///    model groups, **regardless of whether you have a stocked product or a
///    not-stocked product**."
///
///   — learn.microsoft.com/dynamics365/supply-chain/cost-management/inventory-costing-faq
///
/// A tangible item tracked in inventory can be valued at standard cost. A
/// service item can be STOCKED — officially required if it appears on a BOM.
/// Costing method and stocked-ness are orthogonal axes and the seed data must
/// demonstrate that, not collapse it.
model ItemModelGroup {
  id              String  @id @default(uuid()) @db.Uuid
  tenant_id       String  @db.Uuid
  legal_entity_id String? @db.Uuid

  code        String
  name        String
  description String?

  // ── Axis 1: valuation ───────────────────────────────────────────────────

  /// FIFO | LIFO | WEIGHTED_AVG | MOVING_AVG | STANDARD
  /// **[OFFICIAL]** "You can select only one costing model for each released
  /// product. The item model group controls this behavior."
  /// Only FIFO is implemented in the costing engine today; the rest are the enum
  /// values that let a future tenant be configured rather than forked.
  /// Changing this once transactions exist is not a supported operation.
  costing_method String @default("FIFO")

  /// **[OFFICIAL]** include physically-updated receipts in the running average.
  include_physical_value Boolean @default(false)

  /// **[OFFICIAL]** use the receipt price as the standard cost, posting the
  /// difference to fixed-receipt-price profit/loss with an offset. Meaningful
  /// alongside a periodic model when a purchase-price variance must be visible.
  /// Hook only — the variance accounts are not configured yet.
  fixed_receipt_price Boolean @default(false)

  // ── Axis 2: is it inventory at all ──────────────────────────────────────

  /// **[OFFICIAL]** "Enable the Stocked product option for any item that you want
  /// to track in your inventory […] If you don't enable [it], the system doesn't
  /// track any inventory transactions in the inventory subledger, and the cost of
  /// the items is typically expensed into your general ledger."
  ///
  /// Note the official caveat that kills the "not stocked = service" shortcut:
  /// "You should also enable this option if you plan to add a non-tangible item
  /// such as a **service item** to your bills of materials (BOMs) or formulas."
  stocked Boolean @default(true)

  // ── Axis 3: what reaches the general ledger, and when ───────────────────

  /// **[OFFICIAL]** a physical update (product receipt, packing slip) and a
  /// financial update (vendor invoice, sales invoice) raise SEPARATE vouchers.
  /// These two switches decide whether each one does. Both true reproduces
  /// today's behaviour exactly.
  post_physical_inventory  Boolean @default(true)
  post_financial_inventory Boolean @default(true)

  /// **[OFFICIAL]** "In most organizations, enable [this] for all item model
  /// groups, regardless of whether you have a stocked product or a not-stocked
  /// product… most organizations must recognize the liability on the balance
  /// sheet to comply with local regulations such as GAAP."
  /// Default true for that reason. Hook only — no accrual account yet.
  accrue_liability_on_receipt Boolean @default(true)

  /// **[OFFICIAL]** recognise revenue in the ledger at packing slip rather than
  /// at invoice. "Use this option when there's a long delay between the packing
  /// slip and invoice." Off by default, which is right when invoicing follows
  /// delivery immediately — as it does at a shop counter.
  post_deferred_revenue_on_delivery Boolean @default(false)

  // ── Axis 4: process gates ───────────────────────────────────────────────
  //
  // Four independent "you may not do B before A" rules. [OFFICIAL] each applies
  // to ALL receipts or issues for the item, not only to purchase or sales
  // orders — an inventory journal with a positive quantity is caught too.

  /// No product receipt until an arrival registration exists (two-step receiving).
  registration_requirements Boolean @default(false)
  /// No vendor invoice until a product receipt exists (accrual discipline).
  receiving_requirements    Boolean @default(false)
  /// No packing slip until a picking list is posted.
  picking_requirements      Boolean @default(false)
  /// No sales invoice until a packing slip is posted.
  deduction_requirements    Boolean @default(false)

  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  products Product[]

  @@unique([tenant_id, legal_entity_id, code])
  @@map("item_model_groups")
}

/// WHERE an item's money goes. The item axis of the posting matrix.
///
/// Deliberately NOT merged with `ProductCategory`, which already exists and is a
/// merchandising hierarchy for the storefront. **[OFFICIAL]** D365 keeps them
/// apart too — the inventory posting profile takes *Item code* = Table | Group |
/// All | **Category**, listing group and category as different axes. A category
/// answers "where does this appear in the shop"; an item group answers "which
/// inventory and COGS account does it hit". Conflating them means a
/// merchandising change silently repoints the ledger.
model ItemGroup {
  id              String  @id @default(uuid()) @db.Uuid
  tenant_id       String  @db.Uuid
  legal_entity_id String? @db.Uuid

  code        String
  name        String
  description String?

  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  products Product[]

  @@unique([tenant_id, legal_entity_id, code])
  @@map("item_groups")
}

model ItemTaxGroupCode {
  item_tax_group_id String @db.Uuid
  tax_code_id       String @db.Uuid

  item_tax_group ItemTaxGroup @relation(fields: [item_tax_group_id], references: [id], onDelete: Cascade)
  tax_code       TaxCode      @relation(fields: [tax_code_id], references: [id], onDelete: Cascade)

  @@id([item_tax_group_id, tax_code_id])
  @@map("item_tax_group_codes")
}

// =====================
// PROCESS FRONT ENDS — the documents that come BEFORE the order
// Design: docs/process/PROCESS_CHAIN.md
//
// WHY THIS EXISTS
//
// A sales order does not appear from nowhere and neither does a purchase order.
// Until now both did: the earliest document in this system was the order itself,
// which meant the system could record WHAT was sold but never WHY, to whom it was
// offered first, at what price, or which of several vendors won the business.
//
//   Prospect to Quote (85)  Lead → Opportunity → Quotation → Sales Order
//   Source to Pay (75)      Requisition → RFQ → Purchase Order
//
// Both chains are OFFICIAL end-to-end processes in the Dynamics 365 business
// process catalog, and the split matters: lead/opportunity/quotation is *Prospect
// to Quote*, a separate upstream process, NOT part of Order to Cash.
// learn.microsoft.com/dynamics365/guidance/business-processes/prospect-to-quote-introduction
//
// ── THREE RULES THAT MAKE THIS EXTENSIBLE RATHER THAN A SECOND ERP ─────────
//
// 1. EVERY STEP IS OPTIONAL. Each link in both chains is nullable and each
//    document can be created standalone. A counter sale still goes straight to a
//    sales order with `source_document_type = DIRECT`, exactly as before. Nothing
//    in the existing POS, storefront or order path changed. Which steps a tenant
//    actually uses is declared on SalesParameters / PurchaseParameters, not
//    branched in service code.
//
// 2. SEMANTIC STATUS vs CONFIGURABLE STAGE. `status` is a closed vocabulary the
//    CODE reasons about (OPEN / WON / LOST); `stage_id` points at a per-tenant
//    `SalesPipelineStage` row the USER names and orders. This is the same split
//    that `Account.category` versus `Account.code` already makes, and for the
//    same reason: a customer who wants "Demo booked" between two stages edits
//    data, and a customer whose pipeline has nine stages does not fork the code.
//    Hardcoding a stage enum is the customisation trap this product exists to
//    avoid.
//
// 3. PROVENANCE IS RECORDED AT BOTH HEADER AND LINE. See
//    `PurchaseOrderLine.source_line_id` for why the header alone is not enough.
//
// NOTHING HERE POSTS TO THE GENERAL LEDGER. Leads, opportunities, quotations,
// requisitions and RFQs are all pre-financial: no journal entry, no posting
// profile, no factura. The first financial event remains the order and its
// invoice, which is why none of this can disturb the books.
// =====================

/// User-defined pipeline stages. Rule 2 above: the NAMES and ORDER of the
/// pipeline belong to the tenant, the semantics do not.
///
/// `default_probability` seeds `Opportunity.probability` when a stage is
/// selected, which is what makes a weighted pipeline value computable without
/// asking the user for a percentage on every deal.
model SalesPipelineStage {
  id              String  @id @default(uuid()) @db.Uuid
  tenant_id       String  @db.Uuid
  legal_entity_id String? @db.Uuid

  code                String
  name                String
  sort_order          Int     @default(0)
  /// 0–100. Enforced by a CHECK constraint in the migration — Prisma cannot
  /// express one.
  default_probability Int     @default(50)
  is_active           Boolean @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  opportunities Opportunity[]

  @@unique([tenant_id, legal_entity_id, code])
  @@index([tenant_id, sort_order])
  @@map("sales_pipeline_stages")
}

/// An unqualified prospect.
///
/// **[OFFICIAL]** "Lead management is largely the same as opportunity
/// management. However, keep a lead separate from customer and opportunity data
/// until the lead is qualified. The possible states for a lead are Open,
/// Qualified, and Disqualified."
/// learn.microsoft.com/dynamics365/sales/developer/lead-entity
///
/// That separation is the reason this is its own table rather than a flag on
/// `Customer`: an unqualified lead must never appear in customer lists, AR
/// aging, or lifetime-value figures, and a boolean on `Customer` would leak into
/// all three.
model Lead {
  id        String @id @default(uuid()) @db.Uuid
  tenant_id String @db.Uuid

  lead_number String

  company_name String?
  first_name   String
  last_name    String?
  email        String?
  phone        String?
  city         String?
  country      String?

  /// MANUAL | WEB | REFERRAL | CAMPAIGN | WALK_IN | STOREFRONT | IMPORT
  /// Kept as a string rather than an enum so a tenant can record its own
  /// channels; the reporting value of this column is comparing conversion rate
  /// BY source, which only works if the tenant can name its real sources.
  source String @default("MANUAL")
  /// HOT | WARM | COLD
  rating String @default("WARM")

  /// OPEN | QUALIFIED | DISQUALIFIED — the official three states, no others.
  status            String  @default("OPEN")
  disqualify_reason String?

  owner_user_id    String?  @db.Uuid
  estimated_amount Decimal? @db.Decimal(14, 2)
  currency         String   @default("BOB")
  notes            String?

  /// Set by qualification. **[OFFICIAL]** qualifying a lead associates an
  /// account and contact and creates the opportunity; the lead itself is
  /// retained rather than deleted, "to allow for accurate business reporting,
  /// such as analysis of the effectiveness of different lead sources."
  converted_customer_id String?   @db.Uuid
  qualified_at          DateTime?
  disqualified_at       DateTime?

  created_by String?  @db.Uuid
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  converted_customer  Customer?        @relation("converted_customer", fields: [converted_customer_id], references: [id])
  /// Opportunities still ADDRESSED to this lead (not yet qualified).
  opportunities       Opportunity[]    @relation("opportunity_party")
  /// Opportunities that CAME FROM this lead, whoever they are addressed to now.
  /// This is the one that survives qualification.
  originated          Opportunity[]    @relation("opportunity_origin")
  quotations          SalesQuotation[]

  @@unique([tenant_id, lead_number])
  @@index([tenant_id, status])
  @@index([tenant_id, created_at(sort: Desc)])
  @@map("leads")
}

/// A qualified deal in the pipeline.
///
/// **[OFFICIAL]** "Each opportunity must be associated with one account or a
/// contact" and tracks "the probability of the sale, and the estimated closing
/// date". learn.microsoft.com/dynamics365/sales/developer/create-opportunity
///
/// Here the party is a `Customer` OR a `Lead` — exactly one, enforced by a CHECK
/// constraint in the migration. That mirrors D365 Supply Chain, where a
/// quotation's account type may be *Prospect* rather than *Customer* and the
/// prospect is converted at confirmation.
model Opportunity {
  id        String @id @default(uuid()) @db.Uuid
  tenant_id String @db.Uuid

  opportunity_number String
  name               String

  /// WHO the deal is with. Exactly one of these is set — CHECK constraint:
  /// num_nonnulls(...) = 1.
  customer_id String? @db.Uuid
  lead_id     String? @db.Uuid

  /// WHERE the deal came from, which is a different question from who it is
  /// with, and the distinction is load-bearing.
  ///
  /// Qualifying a lead creates a customer and re-points the opportunity's PARTY
  /// at that customer — at which moment `lead_id` must become null to satisfy
  /// the exactly-one-party rule. Without a separate column the origin is simply
  /// destroyed, and "which lead sources actually convert" — the one question
  /// lead tracking exists to answer — becomes unanswerable.
  ///
  /// D365 keeps the same separation: an opportunity has a customer AND an
  /// `originatingleadid`. Found by the end-to-end verification script, not by
  /// reading the schema.
  originating_lead_id String? @db.Uuid

  /// Where the deal sits in the tenant's own pipeline. Nullable so an
  /// opportunity can exist before the tenant has configured any stages.
  stage_id String? @db.Uuid

  /// OPEN | WON | LOST | CANCELLED — semantics, not pipeline position.
  status String @default("OPEN")

  /// 0–100, CHECK-constrained in the migration. Seeded from the stage.
  probability         Int       @default(50)
  estimated_amount    Decimal   @default(0) @db.Decimal(14, 2)
  currency            String    @default("BOB")
  expected_close_date DateTime? @db.Date

  owner_user_id  String? @db.Uuid
  /// Free text on WON or LOST. A reason-code table is a deferral that needs no
  /// hook: it would be a lookup on this column's successor, with no
  /// back-reference to populate on history.
  outcome_reason String?
  notes          String?

  closed_at  DateTime?
  created_by String?   @db.Uuid
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  customer         Customer?           @relation(fields: [customer_id], references: [id])
  lead             Lead?               @relation("opportunity_party", fields: [lead_id], references: [id])
  originating_lead Lead?               @relation("opportunity_origin", fields: [originating_lead_id], references: [id])
  stage            SalesPipelineStage? @relation(fields: [stage_id], references: [id])
  quotations       SalesQuotation[]

  @@unique([tenant_id, opportunity_number])
  @@index([tenant_id, status])
  @@index([tenant_id, expected_close_date])
  @@index([tenant_id, originating_lead_id])
  @@map("opportunities")
}

/// A priced offer. The last document before the order, and the first one that
/// carries money.
///
/// **[OFFICIAL]** the D365 Supply Chain quotation lifecycle is Created → Sent →
/// (Revised | Lost | Cancelled | Confirmed), where confirming "creates a sales
/// order from the quotation confirmation", links the two so users can navigate
/// between them, and makes the quotation read-only.
/// learn.microsoft.com/dynamics365/fin-ops-core/fin-ops/data-entities/add-efficiency-in-quote-to-cash-concept
///
/// Revision is modelled as a NEW ROW pointing back at its predecessor rather
/// than an in-place edit, for the same reason posting profiles are date
/// effective: what was offered on a given date must stay recoverable after the
/// offer changes.
model SalesQuotation {
  id        String @id @default(uuid()) @db.Uuid
  tenant_id String @db.Uuid

  quotation_number String

  /// Exactly one of these is set — CHECK constraint in the migration. Quoting a
  /// LEAD is the "account type = Prospect" case and is the whole reason the
  /// upstream chain connects to anything.
  customer_id String? @db.Uuid
  lead_id     String? @db.Uuid

  opportunity_id String? @db.Uuid

  /// DRAFT | SENT | REVISED | CONFIRMED | LOST | CANCELLED | EXPIRED
  status String @default("DRAFT")

  quotation_date DateTime  @default(now()) @db.Date
  valid_until    DateTime? @db.Date

  currency        String  @default("BOB")
  subtotal        Decimal @default(0) @db.Decimal(14, 2)
  discount_amount Decimal @default(0) @db.Decimal(14, 2)
  tax_amount      Decimal @default(0) @db.Decimal(14, 2)
  total_amount    Decimal @default(0) @db.Decimal(14, 2)

  site_id      String? @db.Uuid
  warehouse_id String? @db.Uuid
  notes        String?

  /// Revision chain. `revision` is 0 for the original.
  revision       Int     @default(0)
  revised_from_id String? @db.Uuid

  /// Set on CONFIRMED. The reverse direction (`SalesOrder.source_document_id`)
  /// is the generic hook; this one is the direct navigation D365 provides
  /// between a quotation and the order it produced.
  converted_order_id String? @db.Uuid
  outcome_reason     String?

  sent_at      DateTime?
  confirmed_at DateTime?
  closed_at    DateTime?

  created_by String?  @db.Uuid
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  customer        Customer?            @relation(fields: [customer_id], references: [id])
  lead            Lead?                @relation(fields: [lead_id], references: [id])
  opportunity     Opportunity?         @relation(fields: [opportunity_id], references: [id])
  site            Site?                @relation(fields: [site_id], references: [id])
  warehouse       Warehouse?           @relation(fields: [warehouse_id], references: [id])
  revised_from    SalesQuotation?      @relation("quotation_revision", fields: [revised_from_id], references: [id])
  revisions       SalesQuotation[]     @relation("quotation_revision")
  converted_order SalesOrder?          @relation("converted_order", fields: [converted_order_id], references: [id])
  lines           SalesQuotationLine[]

  @@unique([tenant_id, quotation_number])
  @@index([tenant_id, status])
  @@index([tenant_id, quotation_date(sort: Desc)])
  @@map("sales_quotations")
}

model SalesQuotationLine {
  id           String  @id @default(uuid()) @db.Uuid
  quotation_id String  @db.Uuid
  product_id   String  @db.Uuid
  variant_id   String? @db.Uuid

  /// Decimal, unlike `SalesOrderLine.quantity`, which is an Int. That existing
  /// Int is the anomaly — the purchase side is already Decimal(12,2). Conversion
  /// to an order therefore REFUSES a fractional quantity rather than truncating
  /// it silently; see quotation.service.ts.
  quantity     Decimal @db.Decimal(12, 2)
  unit_price   Decimal @db.Decimal(12, 4)
  discount_pct Decimal @default(0) @db.Decimal(5, 2)
  line_total   Decimal @db.Decimal(14, 2)

  /// Same line-level tax hook the order lines carry, so the pending per-line tax
  /// refactor (HANDOVER — required before Turkey or Germany) covers quotations in
  /// the same pass instead of leaving a document type behind.
  item_tax_group_id String?  @db.Uuid
  tax_amount        Decimal? @db.Decimal(14, 2)
  tax_base          Decimal? @db.Decimal(14, 2)

  sort_order Int     @default(0)
  notes      String?

  quotation SalesQuotation  @relation(fields: [quotation_id], references: [id], onDelete: Cascade)
  product   Product         @relation(fields: [product_id], references: [id])
  variant   ProductVariant? @relation(fields: [variant_id], references: [id])

  @@index([quotation_id])
  @@map("sales_quotation_lines")
}

/// An INTERNAL request to buy. Not a vendor-facing document.
///
/// **[OFFICIAL]** "A purchase requisition is an internal document that
/// authorizes the Purchasing department to buy items or services… After a
/// purchase requisition is approved, you can use it to generate a purchase
/// order."
/// learn.microsoft.com/dynamics365/supply-chain/procurement/purchase-requisitions-overview
///
/// Header AND line both carry a status, and the header's is DERIVED from the
/// lines — that is Microsoft's model, not an embellishment: "The overall status
/// of a purchase requisition depends on the status of the purchase requisition
/// lines." It matters because approving four of five requested lines is the
/// normal case, not an edge case.
model PurchaseRequisition {
  id        String @id @default(uuid()) @db.Uuid
  tenant_id String @db.Uuid

  requisition_number String
  requester_user_id  String? @db.Uuid

  site_id      String? @db.Uuid
  warehouse_id String? @db.Uuid

  /// CONSUMPTION | REPLENISHMENT — **[OFFICIAL]** the requisition purpose, which
  /// decides what an approved line generates: consumption produces a purchase
  /// order, replenishment produces one or more fulfilment documents. Only
  /// CONSUMPTION is implemented; REPLENISHMENT is the enum value that lets
  /// transfer orders and (should it ever exist) production attach later without
  /// a migration.
  purpose String @default("CONSUMPTION")

  /// DRAFT | IN_REVIEW | APPROVED | REJECTED | CANCELLED | CLOSED
  status String @default("DRAFT")

  required_date   DateTime? @db.Date
  justification   String?
  estimated_total Decimal   @default(0) @db.Decimal(14, 2)
  currency        String    @default("BOB")

  submitted_at     DateTime?
  approved_at      DateTime?
  approved_by      String?   @db.Uuid
  rejected_at      DateTime?
  rejected_by      String?   @db.Uuid
  rejection_reason String?
  closed_at        DateTime?

  notes      String?
  created_by String?  @db.Uuid
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  site      Site?                     @relation(fields: [site_id], references: [id])
  warehouse Warehouse?                @relation(fields: [warehouse_id], references: [id])
  lines     PurchaseRequisitionLine[]
  rfq_cases RfqCase[]

  @@unique([tenant_id, requisition_number])
  @@index([tenant_id, status])
  @@index([tenant_id, created_at(sort: Desc)])
  @@map("purchase_requisitions")
}

model PurchaseRequisitionLine {
  id             String  @id @default(uuid()) @db.Uuid
  requisition_id String  @db.Uuid
  product_id     String  @db.Uuid
  variant_id     String? @db.Uuid

  quantity            Decimal   @db.Decimal(12, 2)
  estimated_unit_cost Decimal   @default(0) @db.Decimal(12, 4)
  line_total          Decimal   @default(0) @db.Decimal(14, 2)
  required_date       DateTime? @db.Date

  /// The requester's preference, not a commitment. An RFQ exists precisely to
  /// test it.
  preferred_supplier_id String? @db.Uuid

  /// DRAFT | IN_REVIEW | APPROVED | REJECTED | CANCELLED | CLOSED
  /// **[OFFICIAL]** CLOSED means "the purchase requisition line was approved,
  /// and documents are generated" — so CLOSED is what a line becomes once its
  /// purchase order exists, and it is per line, not per requisition.
  status String @default("DRAFT")

  /// What consumed this line. PURCHASE_ORDER | RFQ.
  fulfilled_by_type    String?
  fulfilled_by_line_id String? @db.Uuid

  sort_order Int     @default(0)
  notes      String?

  requisition        PurchaseRequisition @relation(fields: [requisition_id], references: [id], onDelete: Cascade)
  product            Product             @relation(fields: [product_id], references: [id])
  variant            ProductVariant?     @relation(fields: [variant_id], references: [id])
  preferred_supplier Supplier?           @relation("preferred_supplier", fields: [preferred_supplier_id], references: [id])
  rfq_case_lines     RfqCaseLine[]

  @@index([requisition_id])
  @@map("purchase_requisition_lines")
}

/// The sourcing event: WHAT we want to buy and WHO we asked.
///
/// **[OFFICIAL]** D365 splits this in two — an RFQ *case* holds the demand and
/// the lines, and one RFQ per invited vendor holds that vendor's bid. The split
/// is not ceremony: comparing bids is only possible if every vendor answers the
/// same case line, which requires the case line to be a real row that each
/// vendor's reply line points at.
/// learn.microsoft.com/dynamics365/supply-chain/procurement/request-quotations
model RfqCase {
  id        String @id @default(uuid()) @db.Uuid
  tenant_id String @db.Uuid

  rfq_number String
  title      String

  /// PURCHASE_ORDER | PURCHASE_REQUISITION | PURCHASE_AGREEMENT
  /// **[OFFICIAL]** the type decides what accepting a bid produces. The
  /// PURCHASE_REQUISITION type "is automatically assigned" when the case is
  /// generated from a requisition and cannot be chosen manually.
  /// PURCHASE_AGREEMENT is a hook — agreements are deferred.
  purchase_type String @default("PURCHASE_ORDER")

  /// DRAFT | SENT | AWARDED | CANCELLED | CLOSED — the CASE's own lifecycle.
  ///
  /// Deliberately NOT the same thing as D365's stored "lowest status" and
  /// "highest status" aggregates across vendors and lines. Those are computed on
  /// read here (see rfq.service.ts) rather than stored, because a denormalised
  /// aggregate of two child tables is a value that can silently drift out of
  /// agreement with the rows it summarises. At SME row counts the computation is
  /// free.
  status String @default("DRAFT")

  requisition_id String? @db.Uuid
  warehouse_id   String? @db.Uuid

  bid_deadline DateTime?
  currency     String    @default("BOB")
  notes        String?

  sent_at    DateTime?
  awarded_at DateTime?
  closed_at  DateTime?

  created_by String?  @db.Uuid
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  requisition PurchaseRequisition? @relation(fields: [requisition_id], references: [id])
  warehouse   Warehouse?           @relation(fields: [warehouse_id], references: [id])
  lines       RfqCaseLine[]
  requests    RfqRequest[]

  @@unique([tenant_id, rfq_number])
  @@index([tenant_id, status])
  @@map("rfq_cases")
}

/// One demand line on the case. Every vendor bids against this row, which is
/// what makes replies comparable.
model RfqCaseLine {
  id         String  @id @default(uuid()) @db.Uuid
  case_id    String  @db.Uuid
  product_id String  @db.Uuid
  variant_id String? @db.Uuid

  quantity      Decimal   @db.Decimal(12, 2)
  required_date DateTime? @db.Date

  requisition_line_id String? @db.Uuid

  sort_order Int     @default(0)
  notes      String?

  rfq_case         RfqCase                  @relation(fields: [case_id], references: [id], onDelete: Cascade)
  product          Product                  @relation(fields: [product_id], references: [id])
  variant          ProductVariant?          @relation(fields: [variant_id], references: [id])
  requisition_line PurchaseRequisitionLine? @relation(fields: [requisition_line_id], references: [id])
  request_lines    RfqRequestLine[]

  @@index([case_id])
  @@map("rfq_case_lines")
}

/// One invited vendor's bid. D365 calls this "the request for quotation"; the
/// parent is "the RFQ case".
///
/// **[OFFICIAL]** the reply statuses and their ranking are
/// Created < Sent < Received < Rejected < Accepted < Declined < Canceled.
model RfqRequest {
  id          String @id @default(uuid()) @db.Uuid
  tenant_id   String @db.Uuid
  case_id     String @db.Uuid
  supplier_id String @db.Uuid

  /// CREATED | SENT | RECEIVED | ACCEPTED | REJECTED | DECLINED | CANCELLED
  status String @default("CREATED")

  sent_at     DateTime?
  received_at DateTime?
  decided_at  DateTime?

  /// Bid scoring. **[OFFICIAL]** a solicitation type carries scoring criteria
  /// and the totals are compared on the Compare replies page. A single score is
  /// the SME-sized version of that; a criteria table attaches to this column's
  /// successor without touching existing rows.
  score       Int?
  /// **[OFFICIAL]** "you can add a reason code to explain why you accepted or
  /// rejected a bid."
  reason_code String?

  currency       String  @default("BOB")
  total_amount   Decimal @default(0) @db.Decimal(14, 2)
  lead_time_days Int?
  notes          String?

  /// Set when this bid is awarded and a purchase order is generated from it.
  generated_po_id String? @db.Uuid

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  rfq_case RfqCase          @relation(fields: [case_id], references: [id], onDelete: Cascade)
  supplier Supplier         @relation(fields: [supplier_id], references: [id])
  lines    RfqRequestLine[]

  /// One bid per vendor per case. Re-bidding overwrites the lines rather than
  /// creating a rival row, which is what keeps "compare replies" a flat list.
  @@unique([tenant_id, case_id, supplier_id])
  @@index([tenant_id, status])
  @@map("rfq_requests")
}

model RfqRequestLine {
  id           String @id @default(uuid()) @db.Uuid
  request_id   String @db.Uuid
  case_line_id String @db.Uuid

  product_id String  @db.Uuid
  variant_id String? @db.Uuid

  quantity       Decimal   @db.Decimal(12, 2)
  unit_price     Decimal   @default(0) @db.Decimal(12, 4)
  line_total     Decimal   @default(0) @db.Decimal(14, 2)
  delivery_date  DateTime? @db.Date
  lead_time_days Int?

  /// CREATED | SENT | RECEIVED | ACCEPTED | REJECTED
  /// Per line, because **[OFFICIAL]** "You can accept some lines in a bid and
  /// reject others. You can also accept lines from different vendors."
  status String @default("CREATED")

  sort_order Int @default(0)

  request   RfqRequest      @relation(fields: [request_id], references: [id], onDelete: Cascade)
  case_line RfqCaseLine     @relation(fields: [case_line_id], references: [id], onDelete: Cascade)
  product   Product         @relation(fields: [product_id], references: [id])
  variant   ProductVariant? @relation(fields: [variant_id], references: [id])

  @@index([request_id])
  @@index([case_line_id])
  @@map("rfq_request_lines")
}
