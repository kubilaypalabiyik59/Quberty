// Prisma Schema for Skarpine ERP
// Multi-tenant: tenant_id on every table

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =====================
// PLATFORM (public schema)
// =====================

model Tenant {
  id            String   @id @default(uuid()) @db.Uuid
  slug          String   @unique
  name          String
  plan          String   @default("starter")
  modules       Json
  branding      Json?
  language      String   @default("en")
  timezone      String   @default("UTC")
  currency_code String   @default("USD")
  tax_config    Json?
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@map("tenants")
}

// =====================
// USERS & AUTH
// =====================

model User {
  id            String    @id @default(uuid()) @db.Uuid
  tenant_id     String    @db.Uuid
  email         String
  password_hash String
  first_name    String
  last_name     String
  role          String    @default("employee")
  is_active     Boolean   @default(true)
  last_login_at DateTime?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  refresh_tokens RefreshToken[]
  sales_orders   SalesOrder[]   @relation("created_by")
  employees      Employee[]

  @@unique([tenant_id, email])
  @@map("users")
}

model RefreshToken {
  id         String   @id @default(uuid()) @db.Uuid
  user_id    String   @db.Uuid
  token_hash String
  expires_at DateTime
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

// =====================
// LOCATION HIERARCHY
// =====================

model Site {
  id         String   @id @default(uuid()) @db.Uuid
  tenant_id  String   @db.Uuid
  code       String
  name       String
  city       String
  country    String   @default("TR")
  address    String?
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())

  /// Manual coordinate override. Set them and the geocoder is never consulted
  /// for this site — for the warehouse on an industrial estate whose address
  /// text will never resolve to the right spot. Null means resolve from the
  /// address through the `GeoPoint` cache.
  latitude  Float?
  longitude Float?

  warehouses      Warehouse[]
  employees       Employee[]
  sales_orders    SalesOrder[]
  quotations      SalesQuotation[]
  requisitions    PurchaseRequisition[]
  purchase_orders PurchaseOrder[]

  @@unique([tenant_id, code])
  @@map("sites")
}

model Warehouse {
  id         String   @id @default(uuid()) @db.Uuid
  tenant_id  String   @db.Uuid
  site_id    String   @db.Uuid
  code       String
  name       String
  type       String   @default("standard")
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())

  site                Site                  @relation(fields: [site_id], references: [id])
  zones               WarehouseZone[]
  purchase_orders     PurchaseOrder[]
  sales_orders        SalesOrder[]
  warehouse_work      WarehouseWork[]
  waves               Wave[]
  arrival_journals    ArrivalJournal[]
  location_directives LocationDirective[]
  work_templates      WorkTemplate[]
  wave_templates      WaveTemplate[]
  quotations          SalesQuotation[]
  requisitions        PurchaseRequisition[]
  product_receipts    ProductReceipt[]
  rfq_cases           RfqCase[]
  default_for_sales   SalesParameters[]
  parameters          WarehouseParameters?

  @@unique([tenant_id, code])
  @@map("warehouses")
}

/// Warehouse management's module parameters — **per warehouse**, not per tenant.
///
/// **[OFFICIAL]** D365 sets warehouse behaviour on the individual warehouse (e.g.
/// *Default inventory status ID* lives on the Warehouse FastTab), and that is also
/// what this business needs: "receive it and it is sellable" in the shops, directed
/// putaway in the distribution warehouse, at the same time.
///
/// **Deliberately NOT a one-way door.** D365 gates advanced warehousing behind
/// `Use warehouse management processes` on the storage dimension group, which
/// cannot be changed after saving and forces a new warehouse plus a manual
/// inventory move to adopt later. `InventoryStock` here is keyed on `location_id`
/// for every warehouse already, so this is a behaviour switch that can go either
/// way at any time. See docs/process/WAREHOUSE_ROADMAP.md §3.
model WarehouseParameters {
  id           String @id @default(uuid()) @db.Uuid
  tenant_id    String @db.Uuid
  warehouse_id String @unique @db.Uuid

  /// Two-step receiving. **[OFFICIAL]** the difference between inbound method C and
  /// method D: "the receipt is posted first … The warehouse worker then registers
  /// the put-away to make the items available to pick."
  require_putaway Boolean @default(false)

  /// The outbound equivalent. **Nothing reads this yet** — Phase 2/3 of the roadmap.
  /// Declared here because it belongs on the same record and the same screen; the
  /// fact that it is inert is stated rather than left to be discovered.
  require_pick_work Boolean @default(false)

  /// ALL_LOCATIONS (today's behaviour) | PICK_LOCATIONS_ONLY (only stock that has
  /// actually been put away counts as sellable).
  availability_counts String @default("ALL_LOCATIONS")

  /// Where receipts land by default, and where putaway takes them FROM.
  /// **[OFFICIAL]** "during purchase registration, the first pick is always from the
  /// location where the registration occurs" — the FROM is never directive-resolved.
  default_receive_location_id String? @db.Uuid

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  warehouse                Warehouse          @relation(fields: [warehouse_id], references: [id], onDelete: Cascade)
  default_receive_location WarehouseLocation? @relation("default_receive_location", fields: [default_receive_location_id], references: [id])

  @@index([tenant_id])
  @@map("warehouse_parameters")
}

model WarehouseZone {
  id           String   @id @default(uuid()) @db.Uuid
  tenant_id    String   @db.Uuid
  warehouse_id String   @db.Uuid
  code         String
  name         String
  zone_type    String   @default("storage")
  created_at   DateTime @default(now())

  warehouse       Warehouse               @relation(fields: [warehouse_id], references: [id])
  locations       WarehouseLocation[]
  directive_lines LocationDirectiveLine[]

  @@unique([warehouse_id, code])
  @@map("warehouse_zones")
}

model WarehouseLocation {
  id                  String   @id @default(uuid()) @db.Uuid
  tenant_id           String   @db.Uuid
  zone_id             String   @db.Uuid
  code                String
  aisle               String?
  rack                String?
  shelf               String?
  bin                 String?
  location_type       String   @default("bulk")
  is_pick_location    Boolean  @default(false)
  is_receive_location Boolean  @default(false)
  max_weight          Decimal? @db.Decimal(10, 2)
  max_volume          Decimal? @db.Decimal(10, 2)
  is_active           Boolean  @default(true)
  created_at          DateTime @default(now())

  zone              WarehouseZone           @relation(fields: [zone_id], references: [id])
  inventory_stock   InventoryStock[]
  count_lines       InventoryCountLine[]
  pick_work_lines   WarehouseWorkLine[]     @relation("from_location")
  put_work_lines    WarehouseWorkLine[]     @relation("to_location")
  directive_lines   LocationDirectiveLine[]
  inv_tx_from       InventoryTransaction[]  @relation("inv_tx_from")
  inv_tx_to         InventoryTransaction[]  @relation("inv_tx_to")
  cost_layers       InventoryCostLayer[]
  default_receive_for WarehouseParameters[] @relation("default_receive_location")

  @@unique([zone_id, code])
  @@map("warehouse_locations")
}

// =====================
// PRODUCTS
// =====================

// =====================
// PRODUCT INFORMATION MANAGEMENT — SETUP (migration 014)
//
// **[OFFICIAL]** D365 separates three things and the separation is the point:
// the DIMENSION (the axis), the VALUE on that axis, and the DIMENSION GROUP
// (which axes a given product varies by).
// learn.microsoft.com/dynamics365/supply-chain/pim/product-dimensions
//
// Without the group, "this shoe varies by size" and "this shoe varies by size and
// colour" are indistinguishable — so no variant matrix and no completeness check.
// =====================

/// The axis. **[OFFICIAL]** D365 ships five (colour, configuration, size, style,
/// version). Rows rather than an enum, so a footwear tenant that also sells by
/// *width* adds a row instead of waiting for a release.
model ProductDimension {
  id              String  @id @default(uuid()) @db.Uuid
  tenant_id       String  @db.Uuid
  legal_entity_id String? @db.Uuid
  code            String
  name            String
  sort_order      Int     @default(0)
  is_active       Boolean @default(true)
  created_at      DateTime @default(now())

  values       ProductDimensionValue[]
  group_lines  ProductDimensionGroupLine[]
  value_groups ProductDimensionValueGroup[]
  variant_values ProductVariantValue[]

  @@unique([tenant_id, legal_entity_id, code])
  @@map("product_dimensions")
}

/// A value on an axis. `sort_order` is not decoration: sizes are not text, and
/// without it EU 10 sorts before EU 9 on every screen forever.
model ProductDimensionValue {
  id           String  @id @default(uuid()) @db.Uuid
  tenant_id    String  @db.Uuid
  dimension_id String  @db.Uuid
  value        String
  name         String?
  sort_order   Int     @default(0)
  is_active    Boolean @default(true)
  created_at   DateTime @default(now())

  dimension      ProductDimension                    @relation(fields: [dimension_id], references: [id])
  group_members  ProductDimensionValueGroupMember[]
  variant_values ProductVariantValue[]

  @@unique([tenant_id, dimension_id, value])
  @@map("product_dimension_values")
}

/// A named collection of values — D365's size / colour / style groups.
/// **[OFFICIAL]** they exist so a new product inherits EU 36–46 instead of
/// somebody retyping it. For a shoe retailer this is the largest daily-labour
/// item in product setup.
model ProductDimensionValueGroup {
  id           String   @id @default(uuid()) @db.Uuid
  tenant_id    String   @db.Uuid
  dimension_id String   @db.Uuid
  code         String
  name         String
  created_at   DateTime @default(now())

  dimension ProductDimension                   @relation(fields: [dimension_id], references: [id])
  members   ProductDimensionValueGroupMember[]

  @@unique([tenant_id, code])
  @@map("product_dimension_value_groups")
}

model ProductDimensionValueGroupMember {
  group_id String @db.Uuid
  value_id String @db.Uuid

  group ProductDimensionValueGroup @relation(fields: [group_id], references: [id], onDelete: Cascade)
  value ProductDimensionValue      @relation(fields: [value_id], references: [id], onDelete: Cascade)

  @@id([group_id, value_id])
  @@map("product_dimension_value_group_members")
}

/// Which axes a product varies by.
model ProductDimensionGroup {
  id              String   @id @default(uuid()) @db.Uuid
  tenant_id       String   @db.Uuid
  legal_entity_id String?  @db.Uuid
  code            String
  name            String
  is_active       Boolean  @default(true)
  created_at      DateTime @default(now())

  lines      ProductDimensionGroupLine[]
  products   Product[]
  parameters ProductParameters[]

  @@unique([tenant_id, legal_entity_id, code])
  @@map("product_dimension_groups")
}

model ProductDimensionGroupLine {
  id           String @id @default(uuid()) @db.Uuid
  group_id     String @db.Uuid
  dimension_id String @db.Uuid
  sequence     Int    @default(0)

  group     ProductDimensionGroup @relation(fields: [group_id], references: [id], onDelete: Cascade)
  dimension ProductDimension      @relation(fields: [dimension_id], references: [id])

  @@unique([group_id, dimension_id])
  @@map("product_dimension_group_lines")
}

/// The variant's value on each axis. This is what replaced
/// `ProductVariant.attributes` — a typed, ordered, referentially-sound answer to
/// "which size is this variant".
model ProductVariantValue {
  variant_id   String @db.Uuid
  dimension_id String @db.Uuid
  value_id     String @db.Uuid

  variant   ProductVariant        @relation(fields: [variant_id], references: [id], onDelete: Cascade)
  dimension ProductDimension      @relation(fields: [dimension_id], references: [id])
  value     ProductDimensionValue @relation(fields: [value_id], references: [id])

  @@id([variant_id, dimension_id])
  @@index([value_id])
  @@map("product_variant_values")
}

/// PIM's module parameters record. Every other module has had one since
/// migration 001; this module had none.
model ProductParameters {
  id              String  @id @default(uuid()) @db.Uuid
  tenant_id       String  @db.Uuid
  legal_entity_id String? @db.Uuid

  /// Offered when a product master is created and no group is chosen.
  default_dimension_group_id String? @db.Uuid

  /// **[OFFICIAL]** D365 assembles a variant number from segments (master number,
  /// text constant, dimension values). A format string rather than a segment
  /// table: one tenant, one convention, and the richer version is a table this
  /// column later points at.
  variant_number_format String @default("{SKU}-{VALUES}")

  /// Refuse a variant that leaves an axis of its group unset. Default false so
  /// nothing existing breaks; a tenant turns it on once its data is clean.
  require_complete_variants Boolean @default(false)

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  default_dimension_group ProductDimensionGroup? @relation(fields: [default_dimension_group_id], references: [id])

  @@unique([tenant_id, legal_entity_id])
  @@map("product_parameters")
}

model ProductCategory {
  id         String   @id @default(uuid()) @db.Uuid
  tenant_id  String   @db.Uuid
  parent_id  String?  @db.Uuid
  code       String
  name       String
  created_at DateTime @default(now())

  parent   ProductCategory?  @relation("subcategories", fields: [parent_id], references: [id])
  children ProductCategory[] @relation("subcategories")
  products Product[]

  @@unique([tenant_id, code])
  @@map("product_categories")
}

model Product {
  id                String   @id @default(uuid()) @db.Uuid
  tenant_id         String   @db.Uuid
  sku               String
  barcode           String?
  name              String
  description       String?
  category_id       String?  @db.Uuid
  brand             String?
  attributes        Json?
  uom_id            String?  @db.Uuid
  product_type      String   @default("physical") // physical, service, digital
  cost_price        Decimal? @db.Decimal(12, 2)
  selling_price     Decimal  @db.Decimal(12, 2)
  sale_price        Decimal? @db.Decimal(12, 2)
  weight_kg         Decimal? @db.Decimal(8, 3)
  reorder_point     Int      @default(0) // low-stock alert threshold; 0 = no alerting
  /// Product side of the tax intersection — see the TAX ENGINE section. Nullable,
  /// so every existing product keeps the SalesParameters default until classified.
  /// This is the column that carries reduced rates (Turkish KDV 10%/1%, German 7%).
  item_tax_group_id String?  @db.Uuid

  /// ── Product dimensions (migration 014) ──────────────────────────────────
  /// Which axes this product varies by. NULL means it does not vary — and that
  /// is a real answer, not a missing one, so products with no variants are
  /// deliberately left NULL rather than pointed at an empty group.
  dimension_group_id String? @db.Uuid

  /// The hook for selling batch or serial tracking as an option later.
  /// **[OFFICIAL]** D365's equivalent is the tracking dimension group, and the
  /// position of batch relative to Location in the reservation hierarchy is what
  /// actually changes behaviour — see MODULE_FIT_ANALYSIS §1.
  /// Only NONE is implemented. The service layer must refuse to change this once
  /// transactions exist, the same guard as item group and costing method.
  tracking_policy String @default("NONE") // NONE | BATCH | SERIAL

  /// ── Released-product financial setup ────────────────────────────────────
  /// **[OFFICIAL]** both are mandatory fields on a D365 released product, and
  /// they answer different questions: the MODEL group is how the item is valued
  /// and controlled, the ITEM group is which GL accounts it posts to.
  /// Nullable here so existing products keep working; the resolver falls back to
  /// the ALL-scope posting profile and to InventoryParameters.costing_method
  /// exactly as before when they are unset.
  item_model_group_id String? @db.Uuid
  item_group_id       String? @db.Uuid

  images       String[]
  video_urls   String[]
  is_active    Boolean  @default(true)
  is_published Boolean  @default(false)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  category               ProductCategory?          @relation(fields: [category_id], references: [id])
  uom                    UnitOfMeasure?            @relation(fields: [uom_id], references: [id])
  item_tax_group         ItemTaxGroup?             @relation(fields: [item_tax_group_id], references: [id])
  item_model_group       ItemModelGroup?           @relation(fields: [item_model_group_id], references: [id])
  item_group             ItemGroup?                @relation(fields: [item_group_id], references: [id])
  dimension_group        ProductDimensionGroup?    @relation(fields: [dimension_group_id], references: [id])
  variants               ProductVariant[]
  inventory_stock        InventoryStock[]
  inventory_transactions InventoryTransaction[]
  cost_layers            InventoryCostLayer[]
  sales_order_lines      SalesOrderLine[]
  purchase_order_lines   PurchaseOrderLine[]
  count_lines            InventoryCountLine[]
  work_lines             WarehouseWorkLine[]
  quotation_lines        SalesQuotationLine[]
  requisition_lines      PurchaseRequisitionLine[]
  rfq_case_lines         RfqCaseLine[]
  rfq_request_lines      RfqRequestLine[]
  receipt_lines          ProductReceiptLine[]
  vendor_invoice_lines   VendorInvoiceLine[]
  trade_agreements TradeAgreement[]
  factura_lines FacturaLine[]

  @@unique([tenant_id, sku])
  @@map("products")
}

model ProductVariant {
  id              String   @id @default(uuid()) @db.Uuid
  tenant_id       String   @db.Uuid
  product_id      String   @db.Uuid
  sku_variant     String

  /// DEPRECATED by migration 014 — read `values` instead.
  ///
  /// These three carried the variant's identity before product dimensions existed,
  /// and they carried it badly: verified on the live database, `size` and `color`
  /// were NULL on all 150 variants while every one of them held its size in
  /// `attributes` as `{"Sizes": "42"}`. A free-form JSON key with no validation,
  /// no ordering (so "10" sorted before "9") and nothing stopping the next writer
  /// using "Size" or "Beden".
  ///
  /// Left in place rather than dropped: they are empty, so nothing is lost, and
  /// `attributes` is kept so the old and new representations stay comparable.
  /// **Do not write to any of the three.**
  attributes      Json?
  size            String?
  color           String?
  barcode         String?
  additional_cost Decimal  @default(0) @db.Decimal(12, 2)
  is_active       Boolean  @default(true)
  created_at      DateTime @default(now())

  product                Product                @relation(fields: [product_id], references: [id], onDelete: Cascade)
  inventory_stock        InventoryStock[]
  count_lines            InventoryCountLine[]
  inventory_transactions InventoryTransaction[]
  cost_layers            InventoryCostLayer[]

  /// The upstream document lines DO carry a real FK to the variant, unlike
  /// `SalesOrderLine.variant_id` / `PurchaseOrderLine.variant_id`, which are bare
  /// UUID columns. That gap is a known referential-integrity defect
  /// (SCOPE_AND_HOOKS.md §1 item 3) and repeating it on new tables would only
  /// make the eventual cleanup larger.
  quotation_lines   SalesQuotationLine[]
  requisition_lines PurchaseRequisitionLine[]
  rfq_case_lines    RfqCaseLine[]

  /// Migration 014 closed the gap the comment above describes: both order-line
  /// columns are now real foreign keys, verified against 0 orphan rows first.
  sales_order_lines    SalesOrderLine[]
  purchase_order_lines PurchaseOrderLine[]

  /// The variant's value on each axis of its product's dimension group.
  values ProductVariantValue[]
  rfq_request_lines RfqRequestLine[]
  trade_agreements TradeAgreement[]
  factura_lines FacturaLine[]

  @@unique([tenant_id, sku_variant])
  @@map("product_variants")
}

// =====================
// INVENTORY
// =====================

model InventoryStock {
  id           String   @id @default(uuid()) @db.Uuid
  tenant_id    String   @db.Uuid
  product_id   String   @db.Uuid
  variant_id   String?  @db.Uuid
  location_id  String   @db.Uuid
  quantity     Int      @default(0)
  reserved_qty Int      @default(0)
  updated_at   DateTime @updatedAt

  product  Product           @relation(fields: [product_id], references: [id])
  location WarehouseLocation @relation(fields: [location_id], references: [id])
  variant  ProductVariant?   @relation(fields: [variant_id], references: [id])

  @@unique([tenant_id, product_id, variant_id, location_id], name: "tenant_id_product_id_variant_id_location_id")
  @@map("inventory_stock")
}

model InventoryTransaction {
  id               String   @id @default(uuid()) @db.Uuid
  tenant_id        String   @db.Uuid
  transaction_type String
  reference_type   String?
  reference_id     String?  @db.Uuid
  reference_number String? // human-readable: PO-2026-00004 / SO-2026-00004
  product_id       String   @db.Uuid
  variant_id       String?  @db.Uuid
  from_location_id String?  @db.Uuid
  to_location_id   String?  @db.Uuid
  quantity         Int
  unit_cost        Decimal? @db.Decimal(12, 4)
  notes            String?
  performed_by     String?  @db.Uuid
  created_at       DateTime @default(now())

  /// ── Status (migration 016) ──────────────────────────────────────────────
  /// **[OFFICIAL]** "Each inventory transaction has a status that's displayed in
  /// EITHER the Receipt OR the Issue field" — two ladders, never both at once,
  /// which is why these are two columns with a CHECK forbidding the pair.
  /// learn.microsoft.com/dynamics365/finance/general-ledger/inventory-posting-profiles
  ///
  ///   receipt: ORDERED → REGISTERED → RECEIVED → PURCHASED
  ///   issue:   ON_ORDER → RESERVED_ORDERED → RESERVED_PHYSICAL → PICKED → DEDUCTED → SOLD
  ///
  /// REGISTERED is the arrival step, RECEIVED the physical update, PURCHASED the
  /// financial one; DEDUCTED and SOLD are their issue-side equivalents. PICKED is
  /// the state that matters for the warehouse work about to be built: goods taken
  /// from the shelf, still in the building, no longer available to anyone else.
  receipt_status String?
  issue_status   String?

  /// The two dates D365 keeps separately: when the goods moved, and when the cost
  /// reached the ledger. Together with the statuses they make "received but not
  /// invoiced" answerable from the subledger instead of by joining documents.
  physical_date  DateTime?
  financial_date DateTime?

  product       Product            @relation(fields: [product_id], references: [id])
  variant       ProductVariant?    @relation(fields: [variant_id], references: [id])
  from_location WarehouseLocation? @relation("inv_tx_from", fields: [from_location_id], references: [id])
  to_location   WarehouseLocation? @relation("inv_tx_to", fields: [to_location_id], references: [id])

  @@index([tenant_id, product_id])
  @@index([tenant_id, created_at(sort: Desc)])
  @@map("inventory_transactions")
}

// =====================
// FIFO BATCH LEDGER
// =====================

/// A FIFO **cost layer** — not a batch.
///
/// Renamed from `InventoryBatch` by migration 015. It holds `unit_cost`,
/// `received_at`, `source_po_id` and a remaining `quantity`: what a receipt cost,
/// and how much of it is left to consume. It has no batch number, no expiry date
/// and no customer-facing identity.
///
/// **[OFFICIAL]** a *batch* is a tracking dimension that sits in the reservation
/// hierarchy beside serial number, and whether it sits above or below `Location`
/// changes the sales screen, the picking flow and the reservation logic:
/// learn.microsoft.com/dynamics365/supply-chain/warehousing/flexible-warehouse-level-dimension-reservation
///
/// The name was freed deliberately, so that when batch tracking is sold as an
/// option it can take it without this codebase holding two unrelated concepts
/// called "batch". See `Product.tracking_policy`.
model InventoryCostLayer {
  id           String   @id @default(uuid()) @db.Uuid
  tenant_id    String   @db.Uuid
  product_id   String   @db.Uuid
  variant_id   String?  @db.Uuid
  location_id  String   @db.Uuid
  source_po_id String?  @db.Uuid // which PO created this batch
  po_number    String? // human-readable "PO-2026-00004"
  quantity     Int // remaining quantity in this batch
  unit_cost    Decimal  @default(0) @db.Decimal(14, 4)
  received_at  DateTime @default(now())
  created_at   DateTime @default(now())

  product  Product           @relation(fields: [product_id], references: [id])
  variant  ProductVariant?   @relation(fields: [variant_id], references: [id])
  location WarehouseLocation @relation(fields: [location_id], references: [id])

  @@index([tenant_id, product_id, variant_id, received_at(sort: Asc)])
  @@map("inventory_cost_layers")
}

// =====================
// WAREHOUSE WORK
// =====================

model WorkTemplate {
  id           String   @id @default(uuid()) @db.Uuid
  tenant_id    String   @db.Uuid
  code         String
  name         String
  work_type    String
  warehouse_id String   @db.Uuid
  is_active    Boolean  @default(true)
  created_at   DateTime @default(now())

  warehouse Warehouse          @relation(fields: [warehouse_id], references: [id])
  lines     WorkTemplateLine[]

  @@unique([tenant_id, code])
  @@map("work_templates")
}

model WorkTemplateLine {
  id            String  @id @default(uuid()) @db.Uuid
  template_id   String  @db.Uuid
  sequence      Int
  work_type     String
