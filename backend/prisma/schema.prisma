// =====================
// FINANCE
// =====================

model Account {
  id             String   @id @default(uuid()) @db.Uuid
  tenant_id      String   @db.Uuid
  code           String
  name           String
  type           String // ASSET, LIABILITY, EQUITY, REVENUE, EXPENSE
  /// Country-INDEPENDENT semantic classification. This is the field the system
  /// reasons about; `code` is a local label that differs per jurisdiction.
  ///
  ///   Accounts receivable is 1103 in the Bolivian PCG, 120 (Alıcılar) in the
  ///   Turkish Tekdüzen Hesap Planı, and 1200 in the German SKR04. Three numbers,
  ///   one meaning. Anything that resolves an account by CODE is a customisation
  ///   waiting to happen; anything that resolves by CATEGORY ports for free.
  ///
  /// This is D365's main account category, and Microsoft states the purpose
  /// plainly: link main accounts to categories "so you can take advantage of the
  /// default financial reports without making any modifications".
  /// learn.microsoft.com/dynamics365/finance/general-ledger/plan-chart-of-accounts
  ///
  /// Values: see ACCOUNT_CATEGORIES in shared/services/accountCategory.ts.
  /// Nullable because existing rows predate it; the provisioning script backfills.
  category       String?
  normal_balance String   @default("DEBIT") // DEBIT or CREDIT
  parent_id      String?  @db.Uuid
  is_active      Boolean  @default(true)
  created_at     DateTime @default(now())

  parent           Account?         @relation("AccountHierarchy", fields: [parent_id], references: [id])
  children         Account[]        @relation("AccountHierarchy")
  journal_lines    JournalLine[]
  posting_profiles PostingProfile[]
  dimension_rules  DimensionRule[]

  @@unique([tenant_id, code])
  @@map("accounts")
}

model JournalEntry {
  id            String    @id @default(uuid()) @db.Uuid
  tenant_id     String    @db.Uuid
  entry_number  String    @unique
  entry_date    DateTime  @db.Date
  description   String
  source_module String? // SALE, PURCHASE, MANUAL, ADJUSTMENT
  source_id     String?   @db.Uuid
  status        String    @default("DRAFT") // DRAFT, POSTED
  created_by    String?   @db.Uuid
  posted_at     DateTime?
  created_at    DateTime  @default(now())

  /// What this voucher corrects, and why. A correction is a derived document: it
  /// names its subject, states a reason and is reproducible — never a hand-typed
  /// journal that happens to offset something.
  /// **[OFFICIAL]** Business Central: "An entry can only be reversed one time."
  /// The `@unique` is what enforces that.
  corrects_entry_id String?   @unique @db.Uuid
  correction_reason String?
  is_correction     Boolean   @default(false)

  corrects   JournalEntry?  @relation("correction", fields: [corrects_entry_id], references: [id])
  corrected_by JournalEntry? @relation("correction")

  lines JournalLine[]

  @@index([tenant_id, entry_date(sort: Desc)])
  @@index([tenant_id, source_module, source_id])
  @@index([tenant_id, is_correction])
  @@map("journal_entries")
}

model JournalLine {
  id               String  @id @default(uuid()) @db.Uuid
  journal_entry_id String  @db.Uuid
  account_id       String  @db.Uuid
  debit_amount     Decimal @default(0) @db.Decimal(14, 2)
  credit_amount    Decimal @default(0) @db.Decimal(14, 2)
  description      String?

  /// D365's `Correction` field. Under STORNO a correction is a NEGATIVE amount in
  /// the original column, which is otherwise indistinguishable from a legitimately
  /// negative posting. Under REVERSE it is informational.
  is_correction    Boolean @default(false)

  /// ── Financial dimensions (migration 018) ────────────────────────────────
  /// Four fixed slots, not EAV and not two hardcoded FKs — see
  /// docs/architecture/FINANCIAL_DIMENSIONS.md §6.1. Which axis occupies which slot
  /// is `DimensionAttribute.slot`, so a P&L by store is `GROUP BY dimension_1_id`
  /// over one index rather than a join and a pivot.
  ///
  /// NULL means **not coded**, and every report shows it as an explicit
  /// "(unassigned)" bucket. **[OFFICIAL]** Microsoft concedes the framework
  /// "can't determine whether a blank dimension value was intentionally left blank,
  /// or whether the default entry wasn't made" and suggests inventing a value named
  /// `Blank`. We do not: a P&L that silently attributes unattributed revenue is
  /// wrong AND looks right.
  dimension_1_id String? @db.Uuid
  dimension_2_id String? @db.Uuid
  dimension_3_id String? @db.Uuid
  dimension_4_id String? @db.Uuid

  journal_entry JournalEntry @relation(fields: [journal_entry_id], references: [id], onDelete: Cascade)
  account       Account      @relation(fields: [account_id], references: [id])

  dimension_1 DimensionValue? @relation("jl_dim1", fields: [dimension_1_id], references: [id])
  dimension_2 DimensionValue? @relation("jl_dim2", fields: [dimension_2_id], references: [id])
  dimension_3 DimensionValue? @relation("jl_dim3", fields: [dimension_3_id], references: [id])
  dimension_4 DimensionValue? @relation("jl_dim4", fields: [dimension_4_id], references: [id])

  @@index([dimension_1_id], map: "journal_lines_dimension_1_idx")
  @@index([dimension_2_id], map: "journal_lines_dimension_2_idx")
  @@map("journal_lines")
}

// =====================
// FINANCIAL DIMENSIONS (migration 018)
//
// Design and the Learn grounding: docs/architecture/FINANCIAL_DIMENSIONS.md.
// =====================

/// One accounting axis. **[OFFICIAL]** D365 has two dimension types — *custom*,
/// whose values are maintained by hand, and *entity-backed*, whose values come from
/// an existing table picked in "Use values from". `value_source` is that choice.
/// learn.microsoft.com/dynamics365/finance/general-ledger/financial-dimensions#financial-dimension-types
model DimensionAttribute {
  id              String  @id @default(uuid()) @db.Uuid
  tenant_id       String  @db.Uuid
  legal_entity_id String? @db.Uuid

  code String /// STORE, DEPT
  name String

  /// Which `JournalLine.dimension_N_id` column carries this axis. 1..4.
  slot Int

  /// CUSTOM | SITE | WAREHOUSE | OPERATING_UNIT | EMPLOYEE | PRODUCT_CATEGORY
  value_source String @default("CUSTOM")

  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  values     DimensionValue[]
  rules      DimensionRule[]
  defaults   DefaultDimensionAssignment[]

  @@unique([tenant_id, legal_entity_id, code], map: "dimension_attributes_tenant_code_key")
  @@unique([tenant_id, legal_entity_id, slot], map: "dimension_attributes_tenant_slot_key")
  @@map("dimension_attributes")
}

/// One value on one axis. **[OFFICIAL]** entity-backed values are not a mirror of
/// the backing table: a value exists once it is *used*, and renaming happens on the
/// source entity, never on the value list.
model DimensionValue {
  id           String @id @default(uuid()) @db.Uuid
  tenant_id    String @db.Uuid
  attribute_id String @db.Uuid

  /// **[OFFICIAL]** max 30 characters. The same page also restricts the character
  /// set to letters/digits/underscores so a value cannot contain the chart-of-
  /// accounts delimiter — we deliberately do not enforce that half, because
  /// FINANCIAL_DIMENSIONS §5 cut segmented entry so there is no delimiter, and this
  /// tenant's site codes (SITE-WH-001) already contain hyphens.
  /// **If segmented entry is ever added, its delimiter must not be `-`.**
  code String
  name String

  /// The backing row for an entity-backed axis. Not a foreign key: the target table
  /// varies by `value_source` and a polymorphic FK is not expressible.
  source_id String? @db.Uuid

  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  attribute DimensionAttribute @relation(fields: [attribute_id], references: [id], onDelete: Cascade)

  jl_dim1 JournalLine[] @relation("jl_dim1")
  jl_dim2 JournalLine[] @relation("jl_dim2")
  jl_dim3 JournalLine[] @relation("jl_dim3")
  jl_dim4 JournalLine[] @relation("jl_dim4")

  fixed_on DimensionRule[]              @relation("rule_fixed_value")
  defaults DefaultDimensionAssignment[]

  @@unique([tenant_id, attribute_id, code], map: "dimension_values_attr_code_key")
  @@index([tenant_id, attribute_id, source_id], map: "dimension_values_source_idx")
  @@map("dimension_values")
}

/// Whether an axis is required on a line, keyed on the account's **category** —
/// the country-independent classification from migration 003 — rather than on a
/// per-main-account structure tree. FINANCIAL_DIMENSIONS §5 cut the tree and kept
/// its degenerate case, so "revenue and COGS must carry a store" survives a change
/// of chart of accounts and a change of country.
model DimensionRule {
  id              String  @id @default(uuid()) @db.Uuid
  tenant_id       String  @db.Uuid
  legal_entity_id String? @db.Uuid
  attribute_id    String  @db.Uuid

  /// Exactly one of these is set — enforced by a CHECK. Category is the broad rule,
  /// account is the specific override.
  account_category String?
  account_id       String? @db.Uuid

  requirement String @default("OPTIONAL") /// OPTIONAL | REQUIRED

  /// **[OFFICIAL]** D365's *fixed dimension*: at posting the fixed value replaces
  /// whatever is on the line, including a value the user typed. Declared as the
  /// documented hook — **nothing reads it yet**, and the resolver says so.
  fixed_value_id String? @db.Uuid

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  attribute   DimensionAttribute @relation(fields: [attribute_id], references: [id], onDelete: Cascade)
  account     Account?           @relation(fields: [account_id], references: [id], onDelete: Cascade)
  fixed_value DimensionValue?    @relation("rule_fixed_value", fields: [fixed_value_id], references: [id])

  // ⚠ The two uniqueness constraints on this table are PARTIAL indexes and live in
  // migration 019, not here — Prisma cannot express `WHERE account_category IS NOT
  // NULL`. They must be partial: `account_category` and `account_id` are mutually
  // exclusive by CHECK, so a plain NULLS NOT DISTINCT index on one of them collides
  // with every rule keyed on the other. Migration 018 made exactly that mistake.
  //
  // Consequence: **`prisma db push` would drop them.** This repo applies reviewed
  // SQL by hand; do not reconcile this table with db push.
  @@index([tenant_id, attribute_id])
  @@map("dimension_rules")
}

/// **[OFFICIAL]** step 2 of D365's defaulting order fills blanks from the customer,
/// vendor, bank, fixed asset, project or ledger defaults.
/// learn.microsoft.com/dynamics365/finance/general-ledger/dimensions-default-values
///
/// Polymorphic on purpose — the alternative is four near-identical tables.
model DefaultDimensionAssignment {
  id           String @id @default(uuid()) @db.Uuid
  tenant_id    String @db.Uuid
  entity_type  String /// CUSTOMER | SUPPLIER | PRODUCT | EMPLOYEE
  entity_id    String @db.Uuid
  attribute_id String @db.Uuid
  value_id     String @db.Uuid

  created_at DateTime @default(now())

  attribute DimensionAttribute @relation(fields: [attribute_id], references: [id], onDelete: Cascade)
  value     DimensionValue     @relation(fields: [value_id], references: [id], onDelete: Cascade)

  @@unique([tenant_id, entity_type, entity_id, attribute_id], map: "default_dimension_assignments_key")
  @@map("default_dimension_assignments")
}

model Factura {
  id               String   @id @default(uuid()) @db.Uuid
  tenant_id        String   @db.Uuid
  /// The legal number as issued, already rendered through the FACTURA number
  /// sequence format — text, not an integer, because the format may carry a
  /// prefix, a year, or a branch segment in another jurisdiction and adding one
  /// must not be a migration of a legal column.
  ///
  /// Bolivia's format is `{######}`, which is exactly what the clients used to
  /// render with `padStart(6, '0')`, so migration 023 left every issued number
  /// byte-identical: `1` became `000001`, the string that was already printed.
  ///
  /// Ordering is now lexicographic. That agrees with numeric order only while
  /// the width is fixed — correct for `{######}` up to 999999, and the reason
  /// reports sort on `invoice_date` where they can.
  factura_number   String
  source_type      String // SALE, MANUAL
  source_id        String?  @db.Uuid
  customer_name    String
  customer_nit     String? // NIT or CI
  invoice_date     DateTime @db.Date
  subtotal         Decimal  @db.Decimal(14, 2) // net before IVA
  iva_amount       Decimal  @db.Decimal(14, 2) // IVA 13%
  it_amount        Decimal  @default(0) @db.Decimal(14, 2) // IT 3%
  total_amount     Decimal  @db.Decimal(14, 2)
  status           String   @default("ISSUED") // ISSUED, CANCELLED
  notes            String?
  invoice_metadata Json? // snapshot: { vat_label, secondary_tax_name, invoice_label, currency_code }
  created_by       String?  @db.Uuid
  created_at       DateTime @default(now())

  lines FacturaLine[]

  @@unique([tenant_id, factura_number])
  @@index([tenant_id, invoice_date(sort: Desc)])
  @@map("facturas")
}

