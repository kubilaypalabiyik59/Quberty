// =====================
// CONFIGURATION FOUNDATION
// Design: docs/architecture/PARAMETERS_AND_CONFIG.md
//
// Three distinct configuration classes, deliberately NOT merged into one table:
//   posting_profiles  — resolution matrix : which GL account
//   number_sequences  — document numbering : which series, gapless or not
//   *_parameters      — singleton per scope : defaults and functional switches
//
// `legal_entity_id` is nullable on every table here and is the forward hook for a
// tenant that later operates more than one legal company (two SRLs under one owner
// is ordinary in Bolivia, and each has its own NIT and factura authorisation).
// NULL means "tenant-wide default". No LegalEntity table exists yet — the column is
// the part that is expensive to add later, the table is not.
// =====================

/// Resolves a posting type to a GL account, most-specific-first, the way D365
/// posting profiles and price tolerances do (Table → Group → All).
/// Replaces hardcoded account-code literals in the posting routes, which are the
/// root cause of defects D-1…D-7 (docs/process/GAP_ANALYSIS.md).
model PostingProfile {
  id              String  @id @default(uuid()) @db.Uuid
  tenant_id       String  @db.Uuid
  legal_entity_id String? @db.Uuid

  /// AR, AP, REVENUE, VAT_OUTPUT, VAT_INPUT, COGS, INVENTORY,
  /// TAX_TURNOVER_EXPENSE, TAX_TURNOVER_PAYABLE, CASH, BANK, ROUNDING
  posting_type String
  /// ALL | ITEM_GROUP | ITEM | PARTY_GROUP | PARTY — the specificity axis.
  /// ALL is mandatory per posting_type and acts as the fallback; D365 likewise
  /// forbids deleting the All/All default.
  scope_kind   String  @default("ALL")
  /// Null when scope_kind = ALL. Not an FK: the target table depends on scope_kind.
  scope_id     String? @db.Uuid

  account_id String @db.Uuid

  /// Date-effective so a chart-of-accounts change is a new row, never an update
  /// that silently repoints history.
  valid_from DateTime  @db.Date
  valid_to   DateTime? @db.Date

  description String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  account Account @relation(fields: [account_id], references: [id])

  /// Postgres treats NULLs as distinct in unique constraints, which would let
  /// duplicate ALL-scope rows through. The migration replaces this with the same
  /// index declared NULLS NOT DISTINCT (Postgres 15+; Supabase runs 17.6).
  @@unique([tenant_id, legal_entity_id, posting_type, scope_kind, scope_id, valid_from])
  @@index([tenant_id, posting_type, scope_kind])
  @@map("posting_profiles")
}

/// Document numbering framework. D365 splits the sequence definition (Organization
/// administration) from the module binding (parameters page); this is the definition
/// half — `reference` is the binding.
/// Fixes D-5: two ad-hoc series currently share one globally-unique column.
model NumberSequence {
  id              String  @id @default(uuid()) @db.Uuid
  tenant_id       String  @db.Uuid
  legal_entity_id String? @db.Uuid

  /// FACTURA, CREDIT_NOTE, JOURNAL_VOUCHER, SALES_ORDER, PURCHASE_ORDER,
  /// INVENTORY_ADJUSTMENT, TRANSFER, PRODUCT_RECEIPT, VENDOR_INVOICE, PAYMENT
  reference String
  name      String

  /// Segment format. {YYYY} = year, {LE} = legal entity code, {#####} = padded counter.
  /// e.g. "JE-{YYYY}-{#####}" or "F-{######}"
  format String

  /// Gapless. Legally required for some documents in some jurisdictions — the
  /// Bolivian factura series is the open question (HANDOVER.md §7). Continuous
  /// allocation must hold a row lock until the caller's transaction commits, which
  /// is why this is a per-sequence choice and not a global policy.
  continuous Boolean @default(false)

  /// SHARED | LEGAL_ENTITY | FISCAL_YEAR — controls when the counter restarts.
  scope String @default("LEGAL_ENTITY")

  next_number  Int  @default(1)
  /// Set when scope = FISCAL_YEAR; the counter resets when the year rolls over.
  current_year Int?

  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  /// Deferred, and it needs no hook here: gap justification for a continuous
  /// sequence is a separate table keyed on (number_sequence_id, number) and can be
  /// added without touching this one.
  @@unique([tenant_id, legal_entity_id, reference])
  @@map("number_sequences")
}

/// Module parameters — one wide, typed, singleton row per scope per module.
/// Deliberately four typed tables rather than one generic settings(key, value):
/// an EAV blob is how two rival tax configurations came to coexist unnoticed
/// (Tenant.tax_config vs config/tax.ts vs the COA template).

model FinanceParameters {
  id              String  @id @default(uuid()) @db.Uuid
  tenant_id       String  @db.Uuid
  legal_entity_id String? @db.Uuid

  /// Hard-fail a document whose journal cannot post, instead of creating it with
  /// no GL entry. Fixes D-4. Defaults true; exists as a switch only so an existing
  /// tenant can be migrated deliberately rather than abruptly.
  require_balanced_posting       Boolean @default(true)
  allow_posting_to_closed_period Boolean @default(false)

  functional_currency String  @default("BOB")
  /// Rounding tolerance below which a posting imbalance is written to ROUNDING
  /// rather than rejected.
  rounding_tolerance  Decimal @default(0.02) @db.Decimal(14, 2)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([tenant_id, legal_entity_id])
  @@map("finance_parameters")
}

model SalesParameters {
  id              String  @id @default(uuid()) @db.Uuid
  tenant_id       String  @db.Uuid
  legal_entity_id String? @db.Uuid

  /// Tax rates are deliberately NOT columns here. They live on TaxCode and are
  /// resolved through the group ∩ item-group intersection — see the TAX ENGINE
  /// section for why a rate column on this table cannot represent Turkey or
  /// Germany. What belongs here is the DEFAULT used when a party or a product
  /// carries no group of its own.
  default_tax_group_id      String? @db.Uuid
  default_item_tax_group_id String? @db.Uuid

  /// Presentation only. The legal document name differs per jurisdiction
  /// (Factura / Fatura / Rechnung); it is not a tax rule.
  invoice_label String @default("Factura")

  allow_negative_inventory_sale Boolean @default(false)
  require_customer_tax_id       Boolean @default(false)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  default_tax_group      TaxGroup?     @relation(fields: [default_tax_group_id], references: [id])
  default_item_tax_group ItemTaxGroup? @relation(fields: [default_item_tax_group_id], references: [id])

  @@unique([tenant_id, legal_entity_id])
  @@map("sales_parameters")
}

model PurchaseParameters {
  id              String  @id @default(uuid()) @db.Uuid
  tenant_id       String  @db.Uuid
  legal_entity_id String? @db.Uuid

  /// NONE | TWO_WAY | THREE_WAY — mirrors the D365 line matching policy. NONE
  /// today because the vendor invoice document does not exist yet; the column is
  /// the hook so enabling matching later is configuration, not a migration.
  line_matching_policy String  @default("NONE")
  price_tolerance_pct  Decimal @default(0) @db.Decimal(6, 4)

  /// Whether input IVA is recognised at product receipt or at the vendor factura.
  /// Skarpine recognises at receipt today; whether Bolivian law permits that is an
  /// open question (P2P_REFERENCE.md §7). A switch, not a rewrite, once answered.
  vat_input_recognition String @default("RECEIPT") // RECEIPT | INVOICE

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([tenant_id, legal_entity_id])
  @@map("purchase_parameters")
}

model InventoryParameters {
  id              String  @id @default(uuid()) @db.Uuid
  tenant_id       String  @db.Uuid
  legal_entity_id String? @db.Uuid

  /// FIFO | WEIGHTED_AVG | STANDARD. FIFO matches the batch-level unit_cost the
  /// code already keeps. Changing this on a live tenant is not a supported
  /// operation and the service layer must refuse it once transactions exist.
  costing_method           String  @default("FIFO")
  allow_negative_inventory Boolean @default(false)
  /// Landed cost is deferred. The hook is on the batch, not here — this flag only
  /// controls whether the allocation step runs.
  capitalise_landed_cost   Boolean @default(false)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([tenant_id, legal_entity_id])
  @@map("inventory_parameters")
}

// =====================
// TAX ENGINE
//
// WHY THIS EXISTS, AND WHY A RATE COLUMN WAS NOT ENOUGH
//
// The first cut of SalesParameters held `vat_rate` and `turnover_tax_rate` as
// columns. That is Bolivia's shape parameterised, not a tax engine, and it breaks
// the moment the product is sold anywhere else:
//
//   Bolivia  IVA 13% price-INCLUSIVE, plus IT 3% — a turnover tax that is NOT
//            recoverable and exists on the sales side only.
//   Turkey   KDV at 20% / 10% / 1% CONCURRENTLY, plus *tevkifat*: partial
//            withholding where the BUYER remits a share of the VAT, above a
//            statutory invoice threshold, and only for designated withholding
//            agents. One rate column cannot say "20%, of which the buyer remits
//            half".
//   Germany  USt 19% / 7%, plus reverse charge (§13b) where the customer accounts
//            for the tax entirely, plus intra-community supply which is exempt but
//            still must be reported and carries a legal reference on the invoice.
//
// The model below is D365's: a tax code carries the rate and the rules; a tax
// group hangs off the PARTY and an item tax group off the PRODUCT; the codes that
// appear in BOTH are the codes that apply.
//
//   "Both groups contain a list of sales tax codes, and the intersection of the
//    two lists of sales tax codes determines the list of applicable sales tax
//    codes for the transaction."
//   — learn.microsoft.com/dynamics365/finance/general-ledger/indirect-taxes-overview
//
// That intersection is what lets one schema carry all three jurisdictions:
// zero-rated exports, exempt intra-EU supply, reverse charge and multi-rate VAT
// are all "which codes intersect", not "which if-branch runs".
//
// Bolivia stays the default. It becomes a configured jurisdiction, not one of
// several equals with regressions.
// =====================

/// A single tax with its rate and calculation rules. The unit of configuration.
model TaxCode {
  id              String  @id @default(uuid()) @db.Uuid
  tenant_id       String  @db.Uuid
  legal_entity_id String? @db.Uuid

  code String /// IVA13, IT3, KDV20, KDV20TEV5, UST19, UST0EU
  name String

  /// VAT | TURNOVER | WITHHOLDING | EXCISE | EXEMPT
  /// TURNOVER is what makes Bolivia's IT representable: a sales-side,
  /// non-recoverable tax that must never appear in a VAT netting report.
  tax_type String @default("VAT")

  rate Decimal @db.Decimal(9, 6)

  /// Bolivia's IVA is quoted inside the price; Turkish and German VAT are added on
  /// top. This is per code, not per tenant — a jurisdiction can have both.
  is_inclusive Boolean @default(false)

  /// Input tax that can be reclaimed (IVA crédito fiscal, Vorsteuer, indirilecek
  /// KDV). False for Bolivia's IT, which is a cost, not a receivable.
  is_recoverable Boolean @default(true)

  /// DOMESTIC | EU | THIRD — mirrors the D365 country/region type, which is how
  /// intra-community versus export treatment is distinguished for EU reporting.
  region_type String @default("DOMESTIC")

  /// Germany §13b and the EU B2B mechanism: the customer accounts for the tax, so
  /// the supplier calculates it but posts no liability.
  reverse_charge Boolean @default(false)

  is_exempt     Boolean @default(false)
  /// Legal reference printed on the invoice when exempt or reverse charged
  /// (e.g. "§6a UStG", "§13b UStG"). Required for a valid German invoice.
  exempt_reason String?

  /// Turkish tevkifat: the share of the calculated tax the BUYER remits directly,
  /// applied only when the document total reaches `withholding_threshold`.
  /// Null everywhere else. Modelled as a share rather than a separate code so the
  /// invoice can print the split the way a tevkifatlı fatura must.
  withholding_share     Decimal? @db.Decimal(9, 6)
  withholding_threshold Decimal? @db.Decimal(14, 2)

  /// GL routing — reuses the posting profile mechanism rather than duplicating
  /// account configuration. These are PostingProfile.posting_type values, so a tax
  /// code never names a GL account directly.
  posting_type_payable    String  @default("VAT_OUTPUT")
  posting_type_receivable String? @default("VAT_INPUT")

  /// Hook only. Settlement periods (monthly Turkish return due the 26th, German
  /// Voranmeldung, Bolivian monthly IVA) are deferred; the table attaches here
  /// without touching this one.
  settlement_period_id String? @db.Uuid

  valid_from DateTime  @db.Date
  valid_to   DateTime? @db.Date
  is_active  Boolean   @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tax_group_codes      TaxGroupCode[]
  item_tax_group_codes ItemTaxGroupCode[]

  @@unique([tenant_id, legal_entity_id, code, valid_from])
  @@index([tenant_id, is_active])
  @@map("tax_codes")
}

/// Attached to the PARTY — customer or supplier. Answers "who are we trading with"
/// (domestic, EU business with a validated VAT ID, export, withholding agent).
model TaxGroup {
  id              String  @id @default(uuid()) @db.Uuid
  tenant_id       String  @db.Uuid
  legal_entity_id String? @db.Uuid

  code        String
  name        String
  description String?
  is_active   Boolean @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  codes               TaxGroupCode[]
  customers           Customer[]
  suppliers           Supplier[]
  sales_param_default SalesParameters[]

  @@unique([tenant_id, legal_entity_id, code])
  @@map("tax_groups")
}

/// Attached to the PRODUCT. Answers "what are we selling" (standard rated, reduced
/// rate, exempt, subject to withholding).
model ItemTaxGroup {
  id              String  @id @default(uuid()) @db.Uuid
  tenant_id       String  @db.Uuid
  legal_entity_id String? @db.Uuid

  code        String
  name        String
  description String?
  is_active   Boolean @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  codes               ItemTaxGroupCode[]
  products            Product[]
  sales_param_default SalesParameters[]

  @@unique([tenant_id, legal_entity_id, code])
  @@map("item_tax_groups")
}

model TaxGroupCode {
  tax_group_id String @db.Uuid
  tax_code_id  String @db.Uuid

  tax_group TaxGroup @relation(fields: [tax_group_id], references: [id], onDelete: Cascade)
  tax_code  TaxCode  @relation(fields: [tax_code_id], references: [id], onDelete: Cascade)

  @@id([tax_group_id, tax_code_id])
  @@map("tax_group_codes")
}

model ItemTaxGroupCode {
  item_tax_group_id String @db.Uuid
  tax_code_id       String @db.Uuid

  item_tax_group ItemTaxGroup @relation(fields: [item_tax_group_id], references: [id], onDelete: Cascade)
  tax_code       TaxCode      @relation(fields: [tax_code_id], references: [id], onDelete: Cascade)

  @@id([item_tax_group_id, tax_code_id])
  @@map("item_tax_group_codes")
}
