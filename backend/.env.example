# Skarpine Backend — Environment Variables
# Copy to .env and fill in values

NODE_ENV=development
PORT=3001

# PostgreSQL (local: use Docker; prod: Railway/Supabase)
DATABASE_URL=postgresql://postgres:password@localhost:5432/skarpine_dev

# Redis (local: use Docker; prod: Railway/Upstash)
REDIS_URL=redis://localhost:6379

# JWT — must be strong random strings (min 32 chars)
JWT_SECRET=change-this-to-a-strong-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-this-refresh-secret-also-32-chars-min
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGINS=http://localhost:3000

# Storage (Supabase)
STORAGE_BUCKET=skarpine-uploads
STORAGE_URL=https://your-project.supabase.co/storage/v1
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# AI Video Generation (optional — FAL.ai)
# Get your key at: https://fal.ai/dashboard/keys
FAL_API_KEY=
