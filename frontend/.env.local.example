# Skarpine Frontend — Environment Variables
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
# The store this storefront sells for, by tenant slug (no default). Sign-up
# registers shoppers into it, and visitors browse its public catalogue
# (/storefront/<slug>/...) before signing in. Unset, the shop shows products
# only to a signed-in user.
NEXT_PUBLIC_STOREFRONT_TENANT_SLUG=
